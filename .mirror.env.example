# Standby mirror config. Copy to .mirror.env on BOTH hosts (never committed).
# Runbook: docs/mirror-standby.md

# primary = main server, replica = standby machine. Leave unset to disable.
MIRROR_ROLE=replica

# Both hosts: MariaDB port main publishes on its loopback (127.0.0.1 only).
MIRROR_PRIMARY_DB_PORT=3307

# Both hosts: replication account created on main by `./deploy mirror primary-setup`.
MIRROR_REPL_USER=repl
MIRROR_REPL_PASSWORD=change-me

# Replica only: how the mirror reaches main.
MIRROR_PRIMARY_SSH=sergadm@172.16.51.10
MIRROR_PRIMARY_SSH_KEY=/home/erpmirror/.ssh/erp_mirror
MIRROR_PRIMARY_REPO=/home/sergadm/git/erpnext

# Replica only: seconds between attachment syncs from main.
MIRROR_FILES_INTERVAL=300
