# ERPNext's nginx config. Rendered by tools/nginx/entrypoint.sh, which fills in
# the ${...} placeholders it lists and nothing else — every other $variable in
# here is nginx's own.
#
# Based on /templates/nginx/frappe.conf.template of the frappe/erpnext image.
# What differs: there are no `upstream` blocks. nginx resolves an upstream name
# once, when it loads its config, so a backend that came back with a new IP got
# 502s until somebody restarted nginx — which closes the listening socket.
# Here the address is a variable: it is resolved per request (see resolver.conf,
# written by the entrypoint), and which container it names comes from a file
# ./deploy rewrites and applies with `nginx -s reload`, which never closes the
# socket.

# Written by ./deploy (nginx_target_write):
#   map $host $frappe_backend  { default "backend:8000"; }
#   map $host $frappe_socketio { default "websocket:9000"; }
#   map $host $frappe_assets   { default "assets:8080"; }
# An exact file name, not a wildcard: a missing file has to fail `nginx -t`,
# not leave the variables undefined for the first request to find out.
include /etc/nginx/frappe-target/target.conf;

# Parse the X-Forwarded-Proto header - if set - defaulting to $scheme.
map $http_x_forwarded_proto $proxy_x_forwarded_proto {
	default $scheme;
	https https;
}

server {
	listen 8080;
	server_name ${FRAPPE_SITE_NAME_HEADER};
  absolute_redirect off;
	root /home/frappe/frappe-bench/sites;

	proxy_buffer_size 128k;
	proxy_buffers 4 256k;
	proxy_busy_buffers_size 256k;

	include /etc/nginx/snippets/security_headers.conf;

	set_real_ip_from ${UPSTREAM_REAL_IP_ADDRESS};
	real_ip_header ${UPSTREAM_REAL_IP_HEADER};
	real_ip_recursive ${UPSTREAM_REAL_IP_RECURSIVE};

	# For the container healthcheck and for counting connections during a deploy.
	location = /nginx_status {
		stub_status;
		access_log off;
		allow 127.0.0.1;
		deny all;
	}

	# Assets come from the release that is live, not from this container: its
	# `assets` service serves the tree built into its own image. That is what
	# lets this container outlive releases. A 404 there — another release's
	# hashed bundle, asked for by a tab loaded before the deploy — and an asset
	# server that is not answering both fall back to the shared union of recent
	# releases (tools/nginx/publish_union.py).
	location /assets {
		proxy_http_version 1.1;
		proxy_set_header Host $host;
		proxy_connect_timeout 2s;
		proxy_intercept_errors on;
		error_page 404 502 504 = @assets_union;
		proxy_pass http://$frappe_assets;
	}

	location @assets_union {
		root /home/frappe/frappe-bench/sites/assets-union;
		try_files $uri =404;
	}

	location ~ ^/protected/(.*) {
		internal;
		try_files /${FRAPPE_SITE_NAME_HEADER}/$1 =404;
	}

	location /socket.io {
		proxy_http_version 1.1;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection "upgrade";
		proxy_set_header X-Frappe-Site-Name ${FRAPPE_SITE_NAME_HEADER};
		proxy_set_header Origin $proxy_x_forwarded_proto://${FRAPPE_SITE_NAME_HEADER};
		proxy_set_header Host $host;
		# Required: without it nginx applies `proxy_redirect default`, which is a
		# config error next to a proxy_pass that uses a variable.
		proxy_redirect off;

		# No URI part after the variable, ever — not even "/". Without one nginx
		# forwards the request URI untouched; with one it replaces the part that
		# matched the location and every /socket.io/* path breaks.
		proxy_pass http://$frappe_socketio;
	}

	location / {
		rewrite ^(.+)/$ $1 permanent;
		rewrite ^(.+)/index\.html$ $1 permanent;
		rewrite ^(.+)\.html$ $1 permanent;

		location ~ ^/files/.*.(htm|html|svg|xml) {
			include /etc/nginx/snippets/security_headers.conf;
			add_header Content-disposition "attachment";
			try_files /${FRAPPE_SITE_NAME_HEADER}/public/$uri @webserver;
		}

		try_files /${FRAPPE_SITE_NAME_HEADER}/public/$uri @webserver;
	}

	location @webserver {
		proxy_http_version 1.1;
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
		proxy_set_header X-Frappe-Site-Name ${FRAPPE_SITE_NAME_HEADER};
		proxy_set_header Host $host;
		proxy_set_header X-Use-X-Accel-Redirect True;
		proxy_read_timeout ${PROXY_READ_TIMEOUT};
		proxy_redirect off;
		# Only for a backend that dies between two DNS refreshes: a refused or
		# timed-out connect is retried once. Never `non_idempotent` — a POST that
		# may have reached the backend is not sent twice.
		proxy_next_upstream error timeout;
		proxy_next_upstream_tries 2;
		proxy_connect_timeout 2s;

		proxy_pass http://$frappe_backend;
	}

	# optimizations
	sendfile on;
	keepalive_timeout 15;
	client_max_body_size ${CLIENT_MAX_BODY_SIZE};
	client_body_buffer_size 16K;
	client_header_buffer_size 1k;

	# enable gzip compression
	# based on https://mattstauffer.co/blog/enabling-gzip-on-nginx-servers-including-laravel-forge
	gzip on;
	gzip_http_version 1.1;
	gzip_comp_level 5;
	gzip_min_length 256;
	gzip_proxied any;
	gzip_vary on;
	gzip_types
		application/atom+xml
		application/javascript
		application/json
		application/rss+xml
		application/vnd.ms-fontobject
		application/x-font-ttf
		application/font-woff
		application/x-web-app-manifest+json
		application/xhtml+xml
		application/xml
		font/opentype
		image/svg+xml
		image/x-icon
		text/css
		text/plain
		text/x-component;
		# text/html is always compressed by HttpGzipModule
}
