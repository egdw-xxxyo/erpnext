#!/bin/bash
# updateRepo — pull latest changes for erpnext and all submodules

set -e
DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$DIR"

BRANCH=$(git rev-parse --abbrev-ref HEAD)

echo "==> Pulling erpnext (branch: $BRANCH)..."
git pull origin "$BRANCH"

# `git pull origin <branch>` passes an explicit refspec, which turns tag auto-following off —
# so release tags never arrive and `./deploy` refuses to deploy an "untagged" commit on prod.
echo "==> Fetching tags..."
git fetch --tags --force origin

CURRENT_TAG=$(git tag --points-at HEAD | tail -1)
if [ -n "$CURRENT_TAG" ]; then
    echo "    HEAD is tagged: $CURRENT_TAG"
else
    echo "    WARNING: HEAD ($(git rev-parse --short HEAD)) has no tag — prod deploy will be blocked."
fi

echo "==> Syncing submodule URLs from .gitmodules..."
git submodule sync

echo "==> Updating submodules to latest remote branch..."
git submodule update --init --remote

echo "==> Submodule status:"
git submodule status

echo ""
echo "==> Checking for submodule pointer changes..."
if git diff --quiet frappe 2>/dev/null; then
    echo "No submodule changes."
else
    git add frappe
    echo "Submodules updated. Commit with: git commit -m 'Update frappe submodule'"
fi
