#!/bin/bash
# updateRepo — pull latest changes for erpnext and all submodules

set -e
DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$DIR"
# ops_step: [OPS] milestone markers the ops dashboard parses.
. "$DIR/tools/ops-progress.sh"

BRANCH=$(git rev-parse --abbrev-ref HEAD)

# Deployments follow the submodule commit this repo pins, never the tip of frappe's branch:
# the pinned commit is what the erpnext commit was tested against. Pass --bump-submodules on
# a development machine to move the pointer forward, then commit it.
BUMP_SUBMODULES=0
for arg in "$@"; do
    case "$arg" in
        --bump-submodules) BUMP_SUBMODULES=1 ;;
        *) echo "unknown option: $arg" >&2; exit 2 ;;
    esac
done

# A previous run that bumped the pointer leaves the gitlink modified — staged, even — and
# `git pull` then refuses to touch it: "Your local changes to the following files would be
# overwritten by merge: frappe". Nothing here is worth keeping: the pointer that matters
# arrives with the pull.
if ! git diff --quiet -- frappe || ! git diff --cached --quiet -- frappe; then
    echo "==> Discarding local frappe pointer (the pull brings the pinned one)..."
    git restore --staged --worktree -- frappe 2>/dev/null || {
        git reset -q -- frappe
        git checkout -- frappe
    }
fi

ops_step repo start "Pulling erpnext ($BRANCH)"
echo "==> Pulling erpnext (branch: $BRANCH)..."
git pull origin "$BRANCH"
ops_step repo ok "erpnext pulled ($BRANCH)"

# `git pull origin <branch>` passes an explicit refspec, which turns tag auto-following off —
# so release tags never arrive.
ops_step tags start "Fetching tags"
echo "==> Fetching tags..."
git fetch --tags --force origin
ops_step tags ok "Tags fetched"

CURRENT_TAG=$(git tag --points-at HEAD | tail -1)
if [ -n "$CURRENT_TAG" ]; then
    echo "    HEAD is tagged: $CURRENT_TAG"
else
    echo "    WARNING: HEAD ($(git rev-parse --short HEAD)) has no tag — prod deploy will be blocked."
fi

ops_step submodules start "Updating submodules"
echo "==> Syncing submodule URLs from .gitmodules..."
git submodule sync

if [ "$BUMP_SUBMODULES" = "1" ]; then
    echo "==> Updating submodules to the tip of their remote branch..."
    git submodule update --init --remote
else
    echo "==> Checking out the pinned submodule commits..."
    git submodule update --init --force
fi

ops_step submodules ok "Submodules updated"
echo "==> Submodule status:"
git submodule status

if [ "$BUMP_SUBMODULES" = "1" ]; then
    echo ""
    echo "==> Checking for submodule pointer changes..."
    if git diff --quiet frappe 2>/dev/null; then
        echo "No submodule changes."
    else
        git add frappe
        echo "Submodules updated. Commit with: git commit -m 'Update frappe submodule'"
    fi
fi
ops_step done ok "Repo up to date"
