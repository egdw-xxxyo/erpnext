# Ops dashboard config. Copy to .ops.env on each host that should run it.
# The dashboard is opt-in: ./deploy only starts it when .ops.env exists.
#
#   cp .ops.env.example .ops.env
#   sed -i "s/^OPS_SESSION_SECRET=.*/OPS_SESSION_SECRET=$(openssl rand -hex 32)/" .ops.env
#   ./deploy ops up

# Required. Signs the session cookie. Rotating it logs everyone out.
OPS_SESSION_SECRET=change-me-openssl-rand-hex-32

# Developer setup, e.g. a laptop with no sshd running: skips SSH entirely,
# runs every command directly inside the ops container against the docker
# socket + repo bind-mounted from the host (docker-compose.ops.local.yml).
# Login then just checks the username against OPS_ALLOWED_USERS below — no
# password, no sshd. Never set this on a shared host.
#OPS_LOCAL_MODE=1

# Optional, but required before the FTP backup target (Settings panel) can be
# saved — encrypts that target's password at rest. Separate from
# OPS_SESSION_SECRET on purpose: rotating this one only invalidates the
# stored FTP config, not every logged-in session.
#OPS_SECRET_KEY=change-me-openssl-rand-hex-32

# Host sshd the dashboard authenticates against and runs commands on.
# Leave OPS_SSH_HOST unset to let ./deploy fill in the host's LAN IP; set it
# explicitly to host.docker.internal if the bridge route works.
#OPS_SSH_HOST=host.docker.internal
OPS_SSH_PORT=22

# Absolute path to this repo ON THE HOST (differs from the path in the container).
OPS_REPO_PATH=/home/mpa/git/erpnext

# ERPNext stack being watched.
OPS_SITE=frontend
OPS_COMPOSE_PROJECT=docker
OPS_ERP_URL=http://127.0.0.1:8080

# Comma-separated usernames allowed to log in. Empty = any user that the
# host's sshd accepts. Checked BEFORE the SSH attempt, so a name that is not
# on this list never reaches sshd. In OPS_LOCAL_MODE this list IS the whole
# auth check (no sshd to fall back on) — it must not be empty there.
OPS_ALLOWED_USERS=sergadm

# Shown in the header so prod and dev are never confused. prod|dev|local
OPS_ENV_LABEL=dev

# Session lifetime / idle timeout, seconds.
OPS_SESSION_TTL=3600
OPS_SESSION_IDLE=1800

# Backup sets to retain. A --with-files set is ~2.7GB; see docs/ops-dashboard.md.
OPS_BACKUP_KEEP=5
