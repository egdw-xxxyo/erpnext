#!/bin/bash
# HRMS is now baked into the Docker image via hrms_app/ submodule.
# This script is kept for backward compatibility with deploy scripts
# that call ./hrms auto.

case "${1:-}" in
  auto)
    # No-op — HRMS is in the image, no runtime install needed
    ;;
  *)
    echo "HRMS is baked into the Docker image (hrms_app/ submodule)."
    echo "No runtime install/uninstall needed."
    echo "To update HRMS: cd hrms_app && git pull && cd .. && ./deploy build"
    ;;
esac
