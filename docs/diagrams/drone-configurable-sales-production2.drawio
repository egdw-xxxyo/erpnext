  <diagram id="drone-config-flow" name="1. Потік: Продаж → Виробництво">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Конфігурований БпЛА — опційні позиції в замовленні (Option Lines) + слоти в BOM" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="300" y="15" width="900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Одне item code для дрона · ціна за опцію з прайсу · собівартість точна на кожен серійний номер · каталог опцій — вкладка 2" style="text;html=1;fontSize=12;align=center;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="300" y="50" width="900" height="24" as="geometry" />
        </mxCell>

        <!-- ==== LANE BACKGROUNDS ==== -->
        <mxCell id="lane1" value="1. Довідники (Master Data)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="1500" height="180" as="geometry" />
        </mxCell>
        <mxCell id="lane2" value="2. Продажі (Sales)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f4fd;strokeColor=#7ea6d0;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#1a4a72;" vertex="1" parent="1">
          <mxGeometry x="40" y="290" width="1500" height="200" as="geometry" />
        </mxCell>
        <mxCell id="lane3" value="3. Виробництво (Production)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf5ea;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#2d5a2d;" vertex="1" parent="1">
          <mxGeometry x="40" y="510" width="1500" height="180" as="geometry" />
        </mxCell>
        <mxCell id="lane4" value="4. Облік і простежуваність (Costing &amp; Traceability)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf1e0;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#7a5200;" vertex="1" parent="1">
          <mxGeometry x="40" y="710" width="1500" height="180" as="geometry" />
        </mxCell>

        <!-- ==== LANE 1: MASTER DATA ==== -->
        <mxCell id="a1" value="&lt;b&gt;Базовий товар (Base Item)&lt;/b&gt;&#xa;БпЛА U 15 FO Серійний&#xa;&#xa;is_stock_item = 1&#xa;has_serial_no = 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="135" width="210" height="105" as="geometry" />
        </mxCell>

        <mxCell id="a2" value="&lt;b&gt;Опційні товари (Option Items)&lt;/b&gt;&#xa;4 групи опцій:&#xa;OPT-DAY-* · OPT-THR-*&#xa;OPT-VTX-A-* · OPT-VTX-D-*&#xa;&lt;i&gt;повний каталог — вкладка 2&lt;/i&gt;&#xa;is_stock_item = 0, носій ціни" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="330" y="135" width="220" height="105" as="geometry" />
        </mxCell>

        <mxCell id="a3" value="&lt;b&gt;Custom Field&lt;/b&gt;&#xa;Item.component_item&#xa;&#xa;OPT-THR-IRAY-MINI2 →&#xa;InfiRay Mini2 640×512" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="135" width="200" height="105" as="geometry" />
        </mxCell>

        <mxCell id="a4" value="&lt;b&gt;Компоненти (Components)&lt;/b&gt;&#xa;Денні: Caddx · RunCam · Foxeer&#xa;Термальні: InfiRay · Guide · FLIR&#xa;Аналог. VTX: TBS · Rush · Foxeer&#xa;Цифрові: DJI O3/O4 · Walksnail · HDZero&#xa;is_stock_item = 1, серійні" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="850" y="135" width="200" height="105" as="geometry" />
        </mxCell>

        <mxCell id="a5" value="&lt;b&gt;BOM-МАСТЕР — 4 слоти&lt;/b&gt;&#xa;FRAME-15 ×1 (фіксовано)&#xa;&lt;b&gt;TPL-CAM-DAY&lt;/b&gt; has_variants=1&#xa;&lt;b&gt;TPL-CAM-THERMAL&lt;/b&gt; has_variants=1&#xa;&lt;b&gt;TPL-VTX&lt;/b&gt; has_variants=1&#xa;&lt;b&gt;TPL-ANT&lt;/b&gt; has_variants=1&#xa;use_multi_level_bom = 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1110" y="130" width="250" height="115" as="geometry" />
        </mxCell>

        <mxCell id="a6" value="&lt;b&gt;Прайс (Item Price)&lt;/b&gt;&#xa;БпЛА базовий — 30 000&#xa;OPT-DAY-* — −600…+1 200&#xa;OPT-THR-* — 0…+71 000&#xa;OPT-VTX-* — −300…+18 000" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1390" y="135" width="140" height="105" as="geometry" />
        </mxCell>

        <!-- ==== LANE 2: SALES ==== -->
        <mxCell id="b1" value="&lt;b&gt;Замовлення клієнта&lt;/b&gt;&#xa;(Sales Order)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="365" width="180" height="70" as="geometry" />
        </mxCell>

        <mxCell id="b2" value="Рядок 1 — БпЛА U 15 FO Серійний ×2 — 30 000 = 60 000&#xa;&lt;i&gt;складський, відвантажується, серійний&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="325" width="330" height="46" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="Рядок 2 — OPT-THR-IRAY-MINI2 ×2 — +62 000 = 124 000&#xa;&lt;i&gt;InfiRay Mini2 640×512 · не складський&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="379" width="330" height="46" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="Рядок 3 — OPT-VTX-D-DJI-O3 ×2 — +14 000 = 28 000&#xa;&lt;i&gt;цифра ⇒ денна камера вбудована (OPT-DAY-NONE)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="433" width="330" height="46" as="geometry" />
        </mxCell>

        <mxCell id="btotal" value="&lt;b&gt;Разом 212 000&lt;/b&gt;&#xa;ціна конфігурації&#xa;з прайсу, без ручних правок" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="680" y="360" width="150" height="80" as="geometry" />
        </mxCell>

        <mxCell id="b6" value="&lt;b&gt;on_submit хук (custom, ~70 рядків)&lt;/b&gt;&#xa;перевіряє правила сумісності (вкладка 2)&#xa;variant_items = [&#xa;  {TPL-CAM-THERMAL → InfiRay Mini2},&#xa;  {TPL-VTX → DJI O3 Air Unit} ]&#xa;+ прибирає слот TPL-CAM-DAY" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="890" y="355" width="300" height="90" as="geometry" />
        </mxCell>

        <mxCell id="b7" value="&lt;b&gt;Альтернатива без коду&lt;/b&gt;&#xa;BOM → Create &gt; Work Order&#xa;діалог питає кожен слот&#xa;&lt;i&gt;bom.js:340 setup_variant_prompt()&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1250" y="355" width="280" height="90" as="geometry" />
        </mxCell>

        <!-- ==== LANE 3: PRODUCTION ==== -->
        <mxCell id="c1" value="&lt;b&gt;make_work_order()&lt;/b&gt;&#xa;bom_no · item · qty · variant_items&#xa;&lt;i&gt;work_order.py:1401&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="570" width="260" height="80" as="geometry" />
        </mxCell>

        <mxCell id="c2" value="&lt;b&gt;add_variant_item()&lt;/b&gt;&#xa;&lt;i&gt;work_order.py:1430&lt;/i&gt;&#xa;TPL-CAM-THERMAL → InfiRay Mini2&#xa;TPL-VTX → DJI O3 Air Unit&#xa;+ перераховує get_bom_item_rate()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="570" width="280" height="80" as="geometry" />
        </mxCell>

        <mxCell id="c3" value="&lt;b&gt;Наряд на роботу (Work Order)&lt;/b&gt;&#xa;required_items:&#xa;• FRAME-15&#xa;• &lt;b&gt;InfiRay Mini2 640×512&lt;/b&gt; ← не шаблон&#xa;• &lt;b&gt;DJI O3 Air Unit&lt;/b&gt;&#xa;• антена 5.8 ГГц" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="710" y="565" width="270" height="90" as="geometry" />
        </mxCell>

        <mxCell id="c4" value="&lt;b&gt;Карти завдань (Job Cards)&lt;/b&gt;&#xa;компоненти згруповані за операцією&#xa;(BOM Item.operation)&#xa;&#xa;Монтаж камери → бачить лише камеру + кріплення" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1030" y="565" width="290" height="90" as="geometry" />
        </mxCell>

        <mxCell id="c5" value="⚠ Працює лише при&#xa;use_multi_level_bom = 0&#xa;&lt;i&gt;work_order.py:1424&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1360" y="575" width="165" height="70" as="geometry" />
        </mxCell>

        <!-- ==== LANE 4: COSTING ==== -->
        <mxCell id="d1" value="&lt;b&gt;Рух ТМЦ: Виробництво&lt;/b&gt;&#xa;(Stock Entry — Manufacture)&#xa;списує &lt;b&gt;реальну&lt;/b&gt; камеру за її вартістю" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="770" width="260" height="80" as="geometry" />
        </mxCell>

        <mxCell id="d2" value="&lt;b&gt;Серійний номер (Serial No)&lt;/b&gt;&#xa;Serial and Batch Entry.incoming_rate&#xa;= фактична собівартість цього борта&#xa;&lt;i&gt;борт з FLIR Boson ≠ борт з Caddx Ant&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="770" width="280" height="80" as="geometry" />
        </mxCell>

        <mxCell id="d3" value="&lt;b&gt;Собівартість продажу (COGS)&lt;/b&gt;&#xa;SerialNoValuation за конкретними&#xa;відвантаженими серійниками&#xa;&lt;i&gt;stock_ledger.py:966&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="710" y="770" width="270" height="80" as="geometry" />
        </mxCell>

        <mxCell id="d4" value="&lt;b&gt;Простежуваність (Traceability)&lt;/b&gt;&#xa;Serial No → work_order → bom_no&#xa;(план)&#xa;Stock Entry рядки → як зібрано (факт)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1030" y="770" width="290" height="80" as="geometry" />
        </mxCell>

        <mxCell id="d5" value="⚠ Серійник &lt;b&gt;не кодує&lt;/b&gt; конфігурацію:&#xa;Item.serial_no_series — на рівні товару&#xa;&lt;i&gt;work_order.py:602&lt;/i&gt;&#xa;Потрібен окремий хук (~30 рядків)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1360" y="770" width="165" height="80" as="geometry" />
        </mxCell>

        <!-- ==== DELIVERY NOTE ==== -->
        <mxCell id="dn" value="&lt;b&gt;Постачання (Delivery Note)&lt;/b&gt;&#xa;лише Рядок 1 (складський)&#xa;опції не відвантажуються →&#xa;&lt;b&gt;немає подвійного обліку&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="915" width="290" height="80" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="&lt;b&gt;Легенда&lt;/b&gt;&#xa;біле / зелене — стандартний ERPNext, коду не треба&#xa;жовте пунктиром — кастом (Custom Field + хук)&#xa;червоне — обмеження / застереження" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="915" width="330" height="80" as="geometry" />
        </mxCell>

