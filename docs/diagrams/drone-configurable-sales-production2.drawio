          <mxGeometry x="1180" y="306" width="350" height="52" as="geometry" />
        </mxCell>
        <mxCell id="r_vtxd_3" value="&lt;b&gt;OPT-VTX-D-HDZ-FS2&lt;/b&gt;&#xa;component_item: HDZero Freestyle V2&#xa;виробник: &lt;b&gt;HDZero&lt;/b&gt;&#xa;дельта ціни: &lt;b&gt;+9 800&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;align=left;spacingLeft=8;fontSize=10;verticalAlign=middle;" vertex="1" parent="1">
