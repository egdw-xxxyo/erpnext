{
 "schema_version": 1,
 "target_doctype": "Consolidated Purchase Order",
 "title": "Consolidated Purchase Order Guide",
 "steps": [
  {
   "id": "cancelled",
   "type": "wait",
   "when": {"docstatus":2},
   "hint": "This document was cancelled."
  },
  {
   "id": "rejected",
   "type": "rule",
   "target": "procurement_route",
   "when": {"workflow_state":"Відхилено"},
   "hint": "This consolidated purchase order was rejected."
  },
  {
   "id": "company",
   "type": "field",
   "field": "company",
   "when": {"fields":[{"field":"workflow_state","operator":"in","value":[null,"","Чернетка","Потребує доопрацювання","Проведено"]},{"field":"procurement_completion_status","operator":"not_equals","value":"Завершено"}],"value":"required_empty"},
   "hint": "Select our buying company. The Purchase Invoice will be recorded under this company."
  },
  {
   "id": "transaction_date",
   "type": "field",
   "field": "transaction_date",
   "when": {"fields":[{"field":"workflow_state","operator":"in","value":[null,"","Чернетка","Потребує доопрацювання","Проведено"]},{"field":"procurement_completion_status","operator":"not_equals","value":"Завершено"}],"value":"required_empty"},
   "hint": "Enter the date this document was created."
  },
  {
   "id": "items",
