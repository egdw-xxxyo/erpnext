  {
   "id": "wait_delivery_notes",
   "type": "rule",
   "target": "procurement_wait_delivery_notes",
   "hint": "Wait for the remaining supplier delivery notes.",
   "emotion": "waiting"
  },
  {
   "id": "route",
   "type": "rule",
   "target": "procurement_route",
   "hint": "Check the approval route for the current order status."
  }
 ]
}
