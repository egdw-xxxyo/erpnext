   "field": "delivery_notes.delivery_note_file",
   "when": {"fields":[{"field":"workflow_state","operator":"in","value":[null,"","Чернетка","Потребує доопрацювання","Проведено"]},{"field":"procurement_completion_status","operator":"not_equals","value":"Завершено"}],"value":"required_empty"},
   "hint": "Attach the supplier's delivery note as a PDF or ZIP file."
  },
  {
   "id": "save",
   "type": "action",
   "target": "save",
   "hint": "Save the document to continue."
  },
  {
   "id": "update",
   "type": "action",
   "target": "update",
   "hint": "Save the document to continue."
  },
  {
   "id": "submit",
   "type": "action",
   "target": "submit",
   "hint": "Submit the document to move it to the next stage."
  },
  {
   "id": "complete",
   "type": "rule",
   "target": "procurement_complete",
   "hint": "Purchasing, payment and receipt are complete.",
   "emotion": "complete"
