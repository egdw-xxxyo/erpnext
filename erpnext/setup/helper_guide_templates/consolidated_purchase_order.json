   "target": "procurement_stock_warehouse",
   "when": {"docstatus":0,"fields":[{"field":"workflow_state","operator":"in","value":[null,"","Чернетка","Потребує доопрацювання"]}]},
   "hint": "Select the receiving warehouse for this stock item."
  },
  {
