   "target": "procurement_review",
   "when": {"docstatus":0,"workflow_state":"Перевірка підрозділу"},
   "hint": "Review the order and choose an available decision in Actions."
  },
  {
   "id": "review_final",
   "type": "rule",
   "target": "procurement_review",
   "when": {"docstatus":0,"workflow_state":"Фінальне погодження"},
   "hint": "Review the order and choose an available decision in Actions."
  },
  {
   "id": "buyer_save",
   "type": "rule",
   "target": "procurement_buyer_save",
   "when": {"docstatus":0},
   "hint": "Save the order before choosing {0}."
  },
  {
   "id": "buyer_actions",
   "type": "rule",
   "target": "procurement_buyer_actions",
   "when": {"docstatus":0},
   "hint": "Open Actions and choose {0}."
  },
  {
   "id": "buyer_route",
   "type": "rule",
   "target": "procurement_buyer_route",
   "when": {"docstatus":0},
   "hint": "Your next action is {0} in the Actions menu."
  },
  {
   "id": "create_invoice",
   "type": "rule",
   "target": "procurement_create_invoice",
   "when": {"docstatus":1},
   "hint": "Open Create and choose Purchase Invoice to record a supplier invoice."
  },
  {
   "id": "missing_invoice",
   "type": "rule",
   "target": "procurement_missing_invoice",
   "when": {"docstatus":1},
