  },
  {
   "id": "attach_delivery_note",
   "type": "rule",
   "target": "procurement_attach_delivery_note",
   "when": {"docstatus":1},
   "hint": "Attach a delivery note for the supplier whose document is missing."
  },
  {
   "id": "payment_route",
   "type": "rule",
   "target": "procurement_payment_route",
   "when": {"docstatus":1},
   "hint": "Open the supplier invoice in Connections to check its payment route."
  },
  {
   "id": "wait_payment",
   "type": "rule",
   "target": "procurement_wait_payment",
   "hint": "Wait for the treasurer to record payment and attach the payment receipt.",
   "emotion": "waiting"
  },
  {
   "id": "wait_preparation",
   "type": "rule",
   "target": "procurement_wait_preparation",
   "hint": "Wait for the buyer to prepare the order and send it for review.",
   "emotion": "waiting"
  },
  {
   "id": "wait_department",
   "type": "rule",
   "target": "procurement_wait_department",
   "hint": "Wait for the department head to review the order.",
   "emotion": "waiting"
  },
  {
   "id": "wait_final",
   "type": "rule",
   "target": "procurement_wait_final",
   "hint": "Wait for the remaining final approvals.",
   "emotion": "waiting"
  },
  {
   "id": "wait_post",
   "type": "rule",
   "target": "procurement_wait_post",
   "when": {"docstatus":0},
   "hint": "Wait for the buyer to post the approved order.",
   "emotion": "waiting"
  },
  {
   "id": "wait_invoices",
   "type": "rule",
   "target": "procurement_wait_invoices",
   "when": {"docstatus":1},
   "hint": "Wait for the buyer to record the remaining supplier invoices.",
   "emotion": "waiting"
  },
  {
   "id": "wait_warehouse",
   "type": "rule",
   "target": "procurement_wait_warehouse",
