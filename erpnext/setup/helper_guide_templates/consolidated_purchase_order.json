   "field": "delivery_notes",
   "when": {"fields":[{"field":"workflow_state","operator":"in","value":[null,"","Чернетка","Потребує доопрацювання","Проведено"]},{"field":"procurement_completion_status","operator":"not_equals","value":"Завершено"}],"value":"required_empty"},
   "hint": "Add a delivery note row for the supplier."
  },
  {
   "id": "delivery_notes_supplier",
   "type": "field",
   "field": "delivery_notes.supplier",
   "when": {"fields":[{"field":"workflow_state","operator":"in","value":[null,"","Чернетка","Потребує доопрацювання","Проведено"]},{"field":"procurement_completion_status","operator":"not_equals","value":"Завершено"}],"value":"required_empty"},
