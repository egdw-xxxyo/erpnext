{
 "doctype": "DocType",
 "name": "Repair Movement",
 "module": "Support",
 "engine": "InnoDB",
 "is_submittable": 1,
 "autoname": "format:RMV-{YYYY}-{#####}",
 "track_changes": 1,
 "sort_field": "creation",
 "sort_order": "DESC",
 "field_order": [
  "issue",
  "repair_order",
  "company",
  "action",
  "warehouse",
  "delivery_type",
  "waybill",
  "delivery_details",
  "disposal_approved",
  "approval",
  "items"
 ],
 "fields": [
  {
   "fieldname": "issue",
   "label": "Service Request",
   "fieldtype": "Link",
   "options": "Issue",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "repair_order",
   "label": "Repair Order",
   "fieldtype": "Link",
   "options": "Repair Order",
   "reqd": 0,
   "in_list_view": 1,
   "hidden": 1
  },
  {
   "fieldname": "company",
   "label": "Company",
   "fieldtype": "Link",
   "options": "Company",
   "reqd": 1
  },
  {
   "fieldname": "action",
   "label": "Repair Action",
   "fieldtype": "Select",
   "options": "receive\ntransfer\ndispatch\ndispose",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "warehouse",
   "label": "Destination Warehouse",
   "fieldtype": "Link",
   "options": "Warehouse"
  },
  {
   "fieldname": "items",
   "label": "Repair Units",
   "fieldtype": "Table",
   "options": "Repair Movement Item",
   "reqd": 1
  },
  {
   "fieldname": "delivery_type",
   "label": "Delivery Type",
   "fieldtype": "Select",
   "options": "\nNova Poshta\nUkrposhta\nTaxi\nSelf Pickup\nOther",
   "read_only": 1,
   "depends_on": "eval:['receive', 'dispatch'].includes(doc.action)"
  },
  {
   "fieldname": "waybill",
   "label": "Waybill",
   "fieldtype": "Data",
   "read_only": 1,
   "depends_on": "eval:['Nova Poshta', 'Ukrposhta'].includes(doc.delivery_type)"
  },
  {
   "fieldname": "delivery_details",
   "label": "Delivery Details",
   "fieldtype": "Small Text",
   "read_only": 1,
   "depends_on": "eval:doc.delivery_type && !['Nova Poshta', 'Ukrposhta'].includes(doc.delivery_type)"
  },
  {
   "fieldname": "disposal_approved",
   "label": "Customer Agreed to Disposal",
   "fieldtype": "Check",
   "read_only": 1,
   "depends_on": "eval:doc.action == 'dispose'"
  },
  {
   "fieldname": "approval",
   "label": "Customer Disposal Approval",
   "fieldtype": "Attach",
   "read_only": 1,
   "depends_on": "eval:doc.action == 'dispose'"
  }
 ],
 "permissions": [
  {
   "role": "Support Team",
   "read": 1,
   "write": 1,
   "create": 1,
   "submit": 1,
   "cancel": 1,
   "report": 1
  },
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "submit": 1,
   "cancel": 1,
   "report": 1
  },
  {
   "role": "Repair Technician",
   "read": 1,
   "write": 1,
   "create": 1,
   "submit": 1,
   "cancel": 1,
   "report": 1
  }
 ]
}
