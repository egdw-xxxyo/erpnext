#!/bin/bash
set -e

DIR="$(cd "$(dirname "$0")" && pwd)"
ERPNEXT_VERSION="v15.96.1"
IMAGE_NAME="erpnext-uk:$ERPNEXT_VERSION"

DEPLOY_ENV_FILE="$DIR/.deploy-env"
if [ -f "$DEPLOY_ENV_FILE" ]; then
  DEPLOY_ENV=$(cat "$DEPLOY_ENV_FILE" | tr -d '[:space:]')
else
  DEPLOY_ENV="dev"
fi

require_non_production() {
  if [ "$DEPLOY_ENV" = "production" ]; then
    echo "ERROR: '$1' is disabled in production environment."
    echo "To change, run: ./deploy setup-dev"
    exit 1
  fi
}

dc() {
  if docker compose version &>/dev/null; then
    docker compose -p docker -f "$DIR/docker-compose.yml" "$@"
  else
    docker-compose -p docker -f "$DIR/docker-compose.yml" "$@"
  fi
}

wait_for_db() {
  echo "==> Waiting for MariaDB..."
  for i in $(seq 1 30); do
    if dc exec -T db mysqladmin ping --password=admin 2>/dev/null | grep -q alive; then
      echo "==> MariaDB is ready."
      return 0
    fi
    sleep 2
  done
  echo "ERROR: MariaDB not ready after 60s. Check: dc logs db"
  exit 1
}

build_image() {
  echo "==> Building image with Ukrainian translations..."
  docker build --build-arg "ERPNEXT_VERSION=$ERPNEXT_VERSION" \
    -t "$IMAGE_NAME" -f "$DIR/Dockerfile.uk" "$DIR"
}

sync_files() {
  MFG_SRC="$DIR/erpnext/manufacturing/doctype"
  MFG_DST="/home/frappe/frappe-bench/apps/erpnext/erpnext/manufacturing/doctype/"
  PAGE_SRC="$DIR/erpnext/manufacturing/page"
  PAGE_DST="/home/frappe/frappe-bench/apps/erpnext/erpnext/manufacturing/page/"
  STOCK_SRC="$DIR/erpnext/stock/doctype"
  STOCK_DST="/home/frappe/frappe-bench/apps/erpnext/erpnext/stock/doctype/"
  WORKSPACE_SRC="$DIR/erpnext/manufacturing/workspace/manufacturing/manufacturing.json"
  WORKSPACE_DST="/home/frappe/frappe-bench/apps/erpnext/erpnext/manufacturing/workspace/manufacturing/manufacturing.json"
  ITEM_SRC="$DIR/erpnext/stock/doctype/item"
  ITEM_DST="/home/frappe/frappe-bench/apps/erpnext/erpnext/stock/doctype/item/"
  STOCK_PY_SRC="$DIR/erpnext/stock"
  STOCK_PY_DST="/home/frappe/frappe-bench/apps/erpnext/erpnext/stock/"
  CONTROLLERS_SRC="$DIR/erpnext/controllers"
  CONTROLLERS_DST="/home/frappe/frappe-bench/apps/erpnext/erpnext/controllers/"

  # Extract stock bom.py from Docker image once (used to restore before patching)
  docker run --rm frappe/erpnext:v15.96.1 cat /home/frappe/frappe-bench/apps/erpnext/erpnext/manufacturing/doctype/bom/bom.py > /tmp/_stock_bom.py 2>/dev/null

  for SERVICE in backend queue-short queue-long scheduler frontend; do
    CID=$(dc ps -q "$SERVICE" 2>/dev/null)
    if [ -z "$CID" ]; then
      continue
    fi
    echo "==> Syncing files to $SERVICE ($CID)..."
    docker cp "$MFG_SRC/label_printer" "$CID:$MFG_DST"
    docker cp "$MFG_SRC/label_size" "$CID:$MFG_DST"
    docker cp "$MFG_SRC/label_template" "$CID:$MFG_DST"
    docker cp "$MFG_SRC/print_job" "$CID:$MFG_DST"
    docker cp "$MFG_SRC/workplace" "$CID:$MFG_DST"
    docker cp "$MFG_SRC/workplace_operation" "$CID:$MFG_DST"
    docker cp "$MFG_SRC/workplace_employee" "$CID:$MFG_DST"
    docker cp "$MFG_SRC/production_log" "$CID:$MFG_DST"
    docker cp "$MFG_SRC/production_log_material" "$CID:$MFG_DST"
    docker cp "$MFG_SRC/production_log_field" "$CID:$MFG_DST"
    docker cp "$MFG_SRC/operation_field" "$CID:$MFG_DST"
    docker cp "$PAGE_SRC/workplace_portal" "$CID:$PAGE_DST"
    docker cp "$PAGE_SRC/production_flow" "$CID:$PAGE_DST"
    docker cp "$PAGE_SRC/print_queue" "$CID:$PAGE_DST"
    docker cp "$MFG_SRC/operation/operation.json" "$CID:${MFG_DST}operation/operation.json"
    docker cp "$MFG_SRC/operation/operation.js" "$CID:${MFG_DST}operation/operation.js"
    docker cp "$MFG_SRC/workstation/workstation.py" "$CID:${MFG_DST}workstation/workstation.py"
    docker cp "$MFG_SRC/workstation/workstation.js" "$CID:${MFG_DST}workstation/workstation.js"
    docker cp "$STOCK_SRC/serial_number_template" "$CID:$STOCK_DST"
    docker cp "$STOCK_SRC/serial_number_template_component" "$CID:$STOCK_DST"
    docker cp "$ITEM_SRC/item.json" "$CID:${ITEM_DST}item.json"
    docker cp "$ITEM_SRC/item.js" "$CID:${ITEM_DST}item.js"
    docker cp "$ITEM_SRC/item.py" "$CID:${ITEM_DST}item.py"
    docker cp "$ITEM_SRC/item_list.js" "$CID:${ITEM_DST}item_list.js"
    docker cp "$STOCK_PY_SRC/serial_batch_bundle.py" "$CID:${STOCK_PY_DST}serial_batch_bundle.py"
    docker cp "$CONTROLLERS_SRC/item_variant.py" "$CID:${CONTROLLERS_DST}item_variant.py"
    docker cp "$STOCK_SRC/item_attribute_value/item_attribute_value.json" "$CID:${STOCK_DST}item_attribute_value/item_attribute_value.json"
    docker cp "$STOCK_SRC/item_attribute/item_attribute.py" "$CID:${STOCK_DST}item_attribute/item_attribute.py"
    # Restore stock bom.py before patching (patch may have corrupted it on previous runs)
    docker cp /tmp/_stock_bom.py "$CID:/home/frappe/frappe-bench/apps/erpnext/erpnext/manufacturing/doctype/bom/bom.py"
    docker cp "$DIR/erpnext/patches/bom_variant_patch.py" "$CID:/tmp/bom_variant_patch.py"
    docker exec -u root "$CID" python3 /tmp/bom_variant_patch.py
    # Note: do NOT copy job_card.json/py — stock v15.96.1 versions are required
    # Our custom job_card.json has fields (track_semi_finished_goods etc.) that
    # reference Work Order columns not present in this ERPNext version
    # job_card.js is safe to copy — it only adds a Production Data dashboard section
    docker cp "$MFG_SRC/job_card/job_card.js" "$CID:${MFG_DST}job_card/job_card.js"
    docker cp "$MFG_SRC/job_card/job_card_list.js" "$CID:${MFG_DST}job_card/job_card_list.js"
    docker cp "$DIR/erpnext/public/js/print.js" "$CID:/home/frappe/frappe-bench/apps/erpnext/erpnext/public/js/print.js"
    docker cp "$DIR/frappe/frappe/printing/page/print/print.js" "$CID:/home/frappe/frappe-bench/apps/frappe/frappe/printing/page/print/print.js"
    docker cp "$DIR/frappe/frappe/printing/doctype/print_format/print_format.json" "$CID:/home/frappe/frappe-bench/apps/frappe/frappe/printing/doctype/print_format/print_format.json"
    docker cp "$WORKSPACE_SRC" "$CID:$WORKSPACE_DST"
    docker cp "$DIR/erpnext/translations/uk.csv" "$CID:/home/frappe/frappe-bench/apps/erpnext/erpnext/translations/uk.csv"
    docker cp "$DIR/frappe/frappe/translations/uk.csv" "$CID:/home/frappe/frappe-bench/apps/frappe/frappe/translations/uk.csv"
    docker exec "$CID" find /home/frappe/frappe-bench/apps/erpnext -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true
  done

}

apply_site_config() {
  SITE_CONFIG="$DIR/site-config.json"
  if [ ! -f "$SITE_CONFIG" ]; then
    return
  fi
  for key in $(python3 -c "import json; d=json.load(open('$SITE_CONFIG')); [print(k) for k in d]"); do
    value=$(python3 -c "import json; print(json.load(open('$SITE_CONFIG'))['$key'])")
    dc exec -T backend bench --site frontend set-config "$key" "$value"
  done
}

case "${1:-}" in
  nuke)
    require_non_production "nuke"
    echo "==> Stopping containers and removing all data..."
    dc down -v
    echo "All data has been removed."
    ;;

  init)
    build_image

    echo "==> Starting ERPNext..."
    dc up -d

    echo "==> Waiting for site to be ready (2-3 min)..."
    until dc exec -T backend bench --site frontend list-apps 2>/dev/null | grep -q erpnext; do
      sleep 5
    done

    echo "==> Enabling Ukrainian language..."
    dc exec -T backend bench --site frontend console <<'PY'
import frappe
if not frappe.db.exists("Language", "uk"):
    frappe.get_doc({"doctype": "Language", "language_code": "uk", "language_name": "Українська", "enabled": 1}).insert(ignore_permissions=True)
    frappe.db.commit()
PY
    echo "==> Applying site config..."
    apply_site_config

    dc exec -T backend bench --site frontend clear-cache

    echo ""
    echo "Ready at http://localhost:8080  (Administrator / admin)"
    echo "Switch language: Settings -> Language -> Українська"
    ;;

  start)
    dc up -d
    echo "==> Syncing custom files..."
    sync_files
    echo "==> Applying site config..."
    apply_site_config
    wait_for_db
    echo "==> Running bench migrate..."
    dc exec -T backend bench --site frontend migrate
    echo "==> Clearing cache..."
    dc exec -T backend bench --site frontend clear-cache
    "$DIR/insights" auto
    # Remove insights from apps.txt before restart — workers will start without it,
    # avoiding ModuleNotFoundError spam. The post-restart auto call re-adds it after syncing.
    dc exec -T backend bash -c "sed -i '/insights/d' /home/frappe/frappe-bench/sites/apps.txt" 2>/dev/null || true
    echo "==> Restarting workers to load new code..."
    dc restart backend queue-short queue-long scheduler frontend websocket
    echo "==> Waiting for backend..."
    sleep 5
    "$DIR/insights" auto
    echo "Started at http://localhost:8080"
    if [ "${2:-}" = "--logs" ]; then
      dc logs -f --since 0s
    fi
    ;;

  stop)
    dc stop
    ;;

  migrate)
    sync_files

    wait_for_db
    echo "==> Running bench migrate..."
    dc exec -T backend bench --site frontend migrate

    echo "==> Clearing cache..."
    dc exec -T backend bench --site frontend clear-cache

    "$DIR/insights" auto
    dc exec -T backend bash -c "sed -i '/insights/d' /home/frappe/frappe-bench/sites/apps.txt" 2>/dev/null || true

    echo "==> Restarting workers to load new code..."
    dc restart backend queue-short queue-long scheduler frontend websocket
    echo "==> Waiting for backend..."
    sleep 5

    "$DIR/insights" auto

    echo "Migration complete."
    ;;

  build)
    build_image

    echo "==> Recreating containers with new image..."
    dc up -d

    echo "==> Syncing custom files..."
    sync_files

    wait_for_db
    echo "==> Running bench migrate..."
    dc exec -T backend bench --site frontend migrate

    echo "==> Clearing cache..."
    dc exec -T backend bench --site frontend clear-cache

    "$DIR/insights" auto
    dc exec -T backend bash -c "sed -i '/insights/d' /home/frappe/frappe-bench/sites/apps.txt" 2>/dev/null || true

    echo "==> Restarting workers..."
    dc restart backend queue-short queue-long scheduler frontend websocket
    echo "==> Waiting for backend..."
    sleep 5

    "$DIR/insights" auto

    echo "Build complete. http://localhost:8080"
    if [ "${2:-}" = "--logs" ]; then
      dc logs -f --since 0s
    fi
    ;;

  destroy)
    require_non_production "destroy"
    dc down -v
    echo "Stopped and removed all data."
    ;;

  setup-prod)
    echo "production" > "$DEPLOY_ENV_FILE"
    echo "Environment set to production. Destructive commands (nuke, destroy) are now disabled."
    ;;

  setup-dev)
    echo "dev" > "$DEPLOY_ENV_FILE"
    echo "Environment set to dev. All commands available."
    ;;

  *)
    echo "Environment: $DEPLOY_ENV"
    echo "Usage: ./deploy {init|start|stop|build|migrate|setup-prod|setup-dev}"
    if [ "$DEPLOY_ENV" != "production" ]; then
      echo "       ./deploy {nuke|destroy}  (dev only)"
    fi
    ;;
esac
