#!/bin/bash
set -e

DIR="$(cd "$(dirname "$0")" && pwd)"
DOCKER_DIR="$DIR/.docker"
ERPNEXT_VERSION="v15.96.1"
IMAGE_NAME="erpnext-uk:$ERPNEXT_VERSION"

DEPLOY_ENV_FILE="$DIR/.deploy-env"
if [ -f "$DEPLOY_ENV_FILE" ]; then
  DEPLOY_ENV=$(cat "$DEPLOY_ENV_FILE" | tr -d '[:space:]')
else
  DEPLOY_ENV="dev"
fi

require_non_production() {
  if [ "$DEPLOY_ENV" = "production" ]; then
    echo "ERROR: '$1' is disabled in production environment."
    echo "To change, run: ./deploy setup-dev"
    exit 1
  fi
}

dc() {
  if docker compose version &>/dev/null; then
    docker compose -f "$DOCKER_DIR/pwd.yml" "$@"
  else
    docker-compose -f "$DOCKER_DIR/pwd.yml" "$@"
  fi
}

init_docker() {
  if [ ! -d "$DOCKER_DIR" ] || [ ! -f "$DOCKER_DIR/pwd.yml" ]; then
    echo "==> Cloning frappe_docker..."
    rm -rf "$DOCKER_DIR"
    git clone --depth 1 https://github.com/frappe/frappe_docker "$DOCKER_DIR"

    if [ ! -f "$DOCKER_DIR/pwd.yml" ]; then
      echo "ERROR: Failed to clone frappe_docker or pwd.yml not found"
      exit 1
    fi
    echo "==> frappe_docker cloned successfully"
  else
    echo "==> frappe_docker already exists, skipping clone"
  fi
}

build_image() {
  echo "==> Building image with Ukrainian translations..."
  docker build --build-arg "ERPNEXT_VERSION=$ERPNEXT_VERSION" \
    -t "$IMAGE_NAME" -f "$DIR/Dockerfile.uk" "$DIR"

  if [ ! -f "$DOCKER_DIR/pwd.yml" ]; then
    echo "ERROR: $DOCKER_DIR/pwd.yml not found. Run init_docker first."
    exit 1
  fi

  echo "==> Patching pwd.yml to use custom image..."
  sed -i.bak "s|image: frappe/erpnext:.*|image: $IMAGE_NAME|g" "$DOCKER_DIR/pwd.yml"
  rm -f "$DOCKER_DIR/pwd.yml.bak"
}

sync_files() {
  MFG_SRC="$DIR/erpnext/manufacturing/doctype"
  MFG_DST="/home/frappe/frappe-bench/apps/erpnext/erpnext/manufacturing/doctype/"
  STOCK_SRC="$DIR/erpnext/stock/doctype"
  STOCK_DST="/home/frappe/frappe-bench/apps/erpnext/erpnext/stock/doctype/"
  WORKSPACE_SRC="$DIR/erpnext/manufacturing/workspace/manufacturing/manufacturing.json"
  WORKSPACE_DST="/home/frappe/frappe-bench/apps/erpnext/erpnext/manufacturing/workspace/manufacturing/manufacturing.json"
  ITEM_SRC="$DIR/erpnext/stock/doctype/item"
  ITEM_DST="/home/frappe/frappe-bench/apps/erpnext/erpnext/stock/doctype/item/"
  STOCK_PY_SRC="$DIR/erpnext/stock"
  STOCK_PY_DST="/home/frappe/frappe-bench/apps/erpnext/erpnext/stock/"
  CONTROLLERS_SRC="$DIR/erpnext/controllers"
  CONTROLLERS_DST="/home/frappe/frappe-bench/apps/erpnext/erpnext/controllers/"

  for SERVICE in backend queue-short queue-long scheduler; do
    CID=$(dc ps -q "$SERVICE" 2>/dev/null)
    if [ -z "$CID" ]; then
      continue
    fi
    echo "==> Syncing files to $SERVICE ($CID)..."
    docker cp "$MFG_SRC/workplace" "$CID:$MFG_DST"
    docker cp "$MFG_SRC/workplace_operation" "$CID:$MFG_DST"
    docker cp "$MFG_SRC/workplace_employee" "$CID:$MFG_DST"
    docker cp "$STOCK_SRC/serial_number_template" "$CID:$STOCK_DST"
    docker cp "$STOCK_SRC/serial_number_template_component" "$CID:$STOCK_DST"
    docker cp "$ITEM_SRC/item.json" "$CID:${ITEM_DST}item.json"
    docker cp "$ITEM_SRC/item.js" "$CID:${ITEM_DST}item.js"
    docker cp "$ITEM_SRC/item.py" "$CID:${ITEM_DST}item.py"
    docker cp "$STOCK_PY_SRC/serial_batch_bundle.py" "$CID:${STOCK_PY_DST}serial_batch_bundle.py"
    docker cp "$CONTROLLERS_SRC/item_variant.py" "$CID:${CONTROLLERS_DST}item_variant.py"
    docker cp "$WORKSPACE_SRC" "$CID:$WORKSPACE_DST"
    docker exec "$CID" find /home/frappe/frappe-bench/apps/erpnext -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true
    docker kill --signal=HUP "$CID" || true
  done
}

apply_site_config() {
  SITE_CONFIG="$DIR/site-config.json"
  if [ ! -f "$SITE_CONFIG" ]; then
    return
  fi
  for key in $(python3 -c "import json; d=json.load(open('$SITE_CONFIG')); [print(k) for k in d]"); do
    value=$(python3 -c "import json; print(json.load(open('$SITE_CONFIG'))['$key'])")
    dc exec -T backend bench --site frontend set-config "$key" "$value"
  done
}

case "${1:-}" in
  nuke)
    require_non_production "nuke"
    echo "==> Stopping containers and removing all data..."
    dc down -v
    echo "All data has been removed."
    ;;

  init)
    init_docker
    build_image

    echo "==> Starting ERPNext..."
    dc up -d

    echo "==> Waiting for site to be ready (2-3 min)..."
    until dc exec -T backend bench --site frontend list-apps 2>/dev/null | grep -q erpnext; do
      sleep 5
    done

    echo "==> Enabling Ukrainian language..."
    dc exec -T backend bench --site frontend console <<'PY'
import frappe
if not frappe.db.exists("Language", "uk"):
    frappe.get_doc({"doctype": "Language", "language_code": "uk", "language_name": "Українська", "enabled": 1}).insert(ignore_permissions=True)
    frappe.db.commit()
PY
    echo "==> Applying site config..."
    apply_site_config

    dc exec -T backend bench --site frontend clear-cache

    echo ""
    echo "Ready at http://localhost:8080  (Administrator / admin)"
    echo "Switch language: Settings -> Language -> Українська"
    ;;

  start)
    dc up -d
    echo "==> Syncing custom files..."
    sync_files
    echo "==> Applying site config..."
    apply_site_config
    echo "==> Running bench migrate..."
    dc exec -T backend bench --site frontend migrate
    echo "==> Clearing cache..."
    dc exec -T backend bench --site frontend clear-cache
    echo "Started at http://localhost:8080"
    if [ "${2:-}" = "--logs" ]; then
      dc logs -f
    fi
    ;;

  stop)
    dc stop
    ;;

  migrate)
    sync_files

    echo "==> Waiting for workers to reload..."
    sleep 3

    echo "==> Running bench migrate..."
    dc exec -T backend bench --site frontend migrate

    echo "==> Clearing cache..."
    dc exec -T backend bench --site frontend clear-cache

    echo "Migration complete."
    ;;

  destroy)
    require_non_production "destroy"
    dc down -v
    echo "Stopped and removed all data."
    ;;

  setup-prod)
    echo "production" > "$DEPLOY_ENV_FILE"
    echo "Environment set to production. Destructive commands (nuke, destroy) are now disabled."
    ;;

  setup-dev)
    echo "dev" > "$DEPLOY_ENV_FILE"
    echo "Environment set to dev. All commands available."
    ;;

  *)
    echo "Environment: $DEPLOY_ENV"
    echo "Usage: ./deploy {init|start|stop|migrate|setup-prod|setup-dev}"
    if [ "$DEPLOY_ENV" != "production" ]; then
      echo "       ./deploy {nuke|destroy}  (dev only)"
    fi
    ;;
esac
