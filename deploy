#!/bin/bash
set -e

DIR="$(cd "$(dirname "$0")" && pwd)"
ERPNEXT_VERSION="v15.96.1"
IMAGE_NAME="erpnext-uk:$ERPNEXT_VERSION"

DEPLOY_ENV_FILE="$DIR/.deploy-env"
if [ -f "$DEPLOY_ENV_FILE" ]; then
  DEPLOY_ENV=$(cat "$DEPLOY_ENV_FILE" | tr -d '[:space:]')
else
  DEPLOY_ENV="dev"
fi

require_non_production() {
  if [ "$DEPLOY_ENV" = "production" ]; then
    echo "ERROR: '$1' is disabled in production environment."
    echo "To change, run: ./deploy setup-dev"
    exit 1
  fi
}

dc() {
  if docker compose version &>/dev/null; then
    docker compose -p docker -f "$DIR/docker-compose.yml" "$@"
  else
    docker-compose -p docker -f "$DIR/docker-compose.yml" "$@"
  fi
}

wait_for_db() {
  echo "==> Waiting for MariaDB..."
  for i in $(seq 1 30); do
    if dc exec -T db mysqladmin ping --password=admin 2>/dev/null | grep -q alive; then
      echo "==> MariaDB is ready."
      return 0
    fi
    sleep 2
  done
  echo "ERROR: MariaDB not ready after 60s. Check: dc logs db"
  exit 1
}

wait_for_backend() {
  echo "==> Waiting for backend..."
  for i in $(seq 1 30); do
    if dc exec -T backend bench --site frontend doctor 2>/dev/null | grep -q "OK" 2>/dev/null || \
       dc exec -T backend python3 -c "import frappe" 2>/dev/null; then
      return 0
    fi
    sleep 2
  done
  echo "WARNING: Backend may not be fully ready after 60s, proceeding anyway."
}

build_image() {
  echo "==> Building full image (all source baked in)..."
  docker build --build-arg "ERPNEXT_VERSION=$ERPNEXT_VERSION" \
    -t "$IMAGE_NAME" -f "$DIR/Dockerfile.full" "$DIR"
}

sync_built_assets() {
  echo "==> Syncing built assets from image to sites volume..."
  # The sites volume shadows /sites/ from the image, so assets built during
  # docker build are not visible. Extract them from the image and copy in.
  docker run --rm "$IMAGE_NAME" tar -cf - \
    -C /home/frappe/frappe-bench/sites/assets \
    frappe erpnext assets.json assets-rtl.json 2>/dev/null | \
    dc exec -T -u root backend tar -xf - -C /home/frappe/frappe-bench/sites/assets/
  dc exec -T -u root backend chown -R frappe:frappe /home/frappe/frappe-bench/sites/assets/
  echo "==> Assets synced."
}

fix_assets() {
  echo "==> Syncing assets from backend to frontend container..."
  FRONTEND_CID=$(dc ps -q frontend 2>/dev/null)
  BACKEND_CID=$(dc ps -q backend 2>/dev/null)
  if [ -z "$FRONTEND_CID" ] || [ -z "$BACKEND_CID" ]; then
    echo "WARNING: frontend or backend container not running, skipping asset sync"
    return 0
  fi

  for i in $(seq 1 15); do
    if docker exec "$BACKEND_CID" test -f /home/frappe/frappe-bench/sites/assets/assets.json 2>/dev/null && \
       docker exec "$FRONTEND_CID" test -d /home/frappe/frappe-bench/sites/assets 2>/dev/null; then
      break
    fi
    [ "$i" = "15" ] && echo "WARNING: containers not fully ready after 30s, attempting sync anyway"
    sleep 2
  done

  for attempt in 1 2 3; do
    docker exec -u root "$FRONTEND_CID" bash -c \
      'rm -rf /home/frappe/frappe-bench/sites/assets/frappe /home/frappe/frappe-bench/sites/assets/erpnext' 2>/dev/null

    if docker exec "$BACKEND_CID" tar -chf - -C /home/frappe/frappe-bench/sites/assets frappe erpnext assets.json assets-rtl.json | \
       docker exec -u root -i "$FRONTEND_CID" tar -xf - -C /home/frappe/frappe-bench/sites/assets/; then
      if docker exec "$FRONTEND_CID" test -f /home/frappe/frappe-bench/sites/assets/assets.json 2>/dev/null; then
        echo "==> Asset sync complete."
        dc exec -T backend bench --site frontend console <<'PY' 2>/dev/null
import frappe
frappe.cache.delete_value("assets_json", shared=True)
PY
        echo "==> Flushed assets_json from Redis cache."
        return 0
      fi
    fi

    echo "WARNING: Asset sync attempt $attempt failed, retrying in 3s..."
    sleep 3
  done

  echo "ERROR: Asset sync failed after 3 attempts. Run './deploy fix-assets' to retry manually."
  return 1
}

remove_insights_before_migrate() {
  echo "==> Removing insights from apps.txt and DB before migrate..."
  dc exec -T backend bash -c "sed -i '/^insights$/d' /home/frappe/frappe-bench/sites/apps.txt && echo 'apps.txt:' && cat /home/frappe/frappe-bench/sites/apps.txt"
  DB_NAME=$(dc exec -T backend bash -c "cat /home/frappe/frappe-bench/sites/*/site_config.json" 2>/dev/null | python3 -c "import sys,json; print(json.load(sys.stdin)['db_name'])" 2>/dev/null)
  if [ -n "$DB_NAME" ]; then
    echo "==> Cleaning insights from DB ($DB_NAME)..."
    dc exec -T db mysql -uroot -padmin "$DB_NAME" -e "
      UPDATE tabDefaultValue
      SET defvalue = REPLACE(REPLACE(REPLACE(defvalue, ', \"insights\"', ''), '\"insights\", ', ''), '\"insights\"', '')
      WHERE parent = '__global'
      AND parentfield = 'system_defaults'
      AND defkey = 'installed_apps'
      AND defvalue LIKE '%insights%';
      SELECT defvalue FROM tabDefaultValue
      WHERE parent = '__global' AND parentfield = 'system_defaults' AND defkey = 'installed_apps';
    " 2>/dev/null || echo "WARNING: DB cleanup query failed (non-fatal)"
  else
    echo "WARNING: Could not detect DB name, skipping DB cleanup"
  fi
}

apply_site_config() {
  SITE_CONFIG="$DIR/site-config.json"
  if [ ! -f "$SITE_CONFIG" ]; then
    return
  fi
  GLOBAL_KEYS="server_script_enabled"
  for key in $(python3 -c "import json; d=json.load(open('$SITE_CONFIG')); [print(k) for k in d]"); do
    value=$(python3 -c "import json; print(json.load(open('$SITE_CONFIG'))['$key'])")
    if echo " $GLOBAL_KEYS " | grep -q " $key "; then
      dc exec -T backend bench set-config -g "$key" "$value"
    else
      dc exec -T backend bench --site frontend set-config "$key" "$value"
    fi
  done
}

case "${1:-}" in
  nuke)
    require_non_production "nuke"
    echo "==> Stopping containers and removing all data..."
    dc down -v
    echo "All data has been removed."
    ;;

  init)
    build_image

    echo "==> Starting ERPNext..."
    dc up -d
    sync_built_assets

    echo "==> Waiting for site to be ready (2-3 min)..."
    until dc exec -T backend bench --site frontend list-apps 2>/dev/null | grep -q erpnext; do
      sleep 5
    done

    echo "==> Enabling Ukrainian language..."
    dc exec -T backend bench --site frontend console <<'PY'
import frappe
if not frappe.db.exists("Language", "uk"):
    frappe.get_doc({"doctype": "Language", "language_code": "uk", "language_name": "Українська", "enabled": 1}).insert(ignore_permissions=True)
    frappe.db.commit()
PY
    echo "==> Applying site config..."
    apply_site_config

    dc exec -T backend bench --site frontend clear-cache

    echo ""
    echo "Ready at http://localhost:8080  (Administrator / admin)"
    echo "Switch language: Settings -> Language -> Українська"
    ;;

  start)
    dc up -d
    echo "==> Waiting for configurator to finish..."
    dc wait configurator 2>/dev/null || sleep 5
    sync_built_assets
    echo "==> Applying site config..."
    apply_site_config
    wait_for_db
    remove_insights_before_migrate
    echo "==> Running bench migrate..."
    dc exec -T backend bench --site frontend migrate
    echo "==> Running setup_custom_fields (custom fields)..."
    dc exec -T backend bench --site frontend execute erpnext.patches.setup_custom_fields.execute
    echo "==> Clearing cache..."
    dc exec -T backend bench --site frontend clear-cache
    "$DIR/insights" auto
    dc exec -T backend bash -c "sed -i '/insights/d' /home/frappe/frappe-bench/sites/apps.txt" 2>/dev/null || true
    echo "==> Restarting workers to load new code..."
    dc restart backend queue-short queue-long scheduler frontend websocket
    wait_for_backend
    "$DIR/insights" auto
    fix_assets
    echo "Started at http://localhost:8080"
    if [ "${2:-}" = "--logs" ]; then
      dc logs -f --since 0s
    fi
    ;;

  stop)
    dc stop
    ;;

  migrate)
    SILENT=0
    for arg in "$@"; do [ "$arg" = "--silent" ] && SILENT=1; done

    if [ "$SILENT" = "1" ]; then
      build_image 2>&1 | tail -5
      dc up -d 2>/dev/null
      dc wait configurator 2>/dev/null || sleep 5
      sync_built_assets >/dev/null 2>&1
      apply_site_config >/dev/null 2>&1
      wait_for_db >/dev/null 2>&1
      remove_insights_before_migrate >/dev/null 2>&1
      dc exec -T backend bench --site frontend migrate >/dev/null 2>&1
      dc exec -T backend bench --site frontend execute erpnext.patches.setup_custom_fields.execute 2>&1 | grep -v "exists" || true
      dc exec -T backend bench --site frontend clear-cache >/dev/null 2>&1
      "$DIR/insights" auto 2>/dev/null
      dc exec -T backend bash -c "sed -i '/insights/d' /home/frappe/frappe-bench/sites/apps.txt" 2>/dev/null || true
      dc restart backend queue-short queue-long scheduler frontend websocket 2>/dev/null
      wait_for_backend 2>/dev/null
      "$DIR/insights" auto 2>/dev/null
      fix_assets 2>/dev/null
      echo "Migration complete."
    else
      build_image

      echo "==> Recreating containers with new image..."
      dc up -d

      echo "==> Waiting for configurator to finish..."
      dc wait configurator 2>/dev/null || sleep 5

      sync_built_assets

      echo "==> Applying site config..."
      apply_site_config

      wait_for_db
      remove_insights_before_migrate
      echo "==> Running bench migrate..."
      dc exec -T backend bench --site frontend migrate
      echo "==> Running setup_custom_fields (custom fields)..."
      dc exec -T backend bench --site frontend execute erpnext.patches.setup_custom_fields.execute
      echo "==> Clearing cache..."
      dc exec -T backend bench --site frontend clear-cache
      "$DIR/insights" auto
      dc exec -T backend bash -c "sed -i '/insights/d' /home/frappe/frappe-bench/sites/apps.txt" 2>/dev/null || true
      echo "==> Restarting workers..."
      dc restart backend queue-short queue-long scheduler frontend websocket
      wait_for_backend
      "$DIR/insights" auto
      fix_assets
      echo "Migration complete."
    fi
    ;;

  build)
    build_image

    echo "==> Recreating containers with new image..."
    dc up -d

    echo "==> Waiting for configurator to finish..."
    dc wait configurator 2>/dev/null || sleep 5

    sync_built_assets

    echo "==> Applying site config..."
    apply_site_config

    wait_for_db
    remove_insights_before_migrate
    echo "==> Running bench migrate..."
    dc exec -T backend bench --site frontend migrate
    echo "==> Running setup_custom_fields (custom fields)..."
    dc exec -T backend bench --site frontend execute erpnext.patches.setup_custom_fields.execute

    echo "==> Clearing cache..."
    dc exec -T backend bench --site frontend clear-cache

    "$DIR/insights" auto
    dc exec -T backend bash -c "sed -i '/insights/d' /home/frappe/frappe-bench/sites/apps.txt" 2>/dev/null || true

    echo "==> Restarting workers..."
    dc restart backend queue-short queue-long scheduler frontend websocket
    wait_for_backend

    "$DIR/insights" auto
    fix_assets

    echo "Build complete. http://localhost:8080"
    if [ "${2:-}" = "--logs" ]; then
      dc logs -f --since 0s
    fi
    ;;

  destroy)
    require_non_production "destroy"
    dc down -v
    echo "Stopped and removed all data."
    ;;

  setup-prod)
    echo "production" > "$DEPLOY_ENV_FILE"
    echo "Environment set to production. Destructive commands (nuke, destroy) are now disabled."
    ;;

  setup-dev)
    echo "dev" > "$DEPLOY_ENV_FILE"
    echo "Environment set to dev. All commands available."
    ;;

  fix-assets)
    fix_assets
    ;;

  *)
    echo "Environment: $DEPLOY_ENV"
    echo "Usage: ./deploy {init|start|stop|build|migrate|fix-assets|setup-prod|setup-dev}"
    if [ "$DEPLOY_ENV" != "production" ]; then
      echo "       ./deploy {nuke|destroy}  (dev only)"
    fi
    ;;
esac
