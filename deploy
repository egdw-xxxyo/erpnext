#!/bin/bash
set -e

DIR="$(cd "$(dirname "$0")" && pwd)"
ERPNEXT_VERSION="v15.119.0"
IMAGE_NAME="erpnext-uk:$ERPNEXT_VERSION"

# Set by the build/migrate handlers when --silent is passed. When 1, the say()
# helper suppresses '==>' progress labels; per-step stdout is also routed to
# /dev/null inside run_deploy. Errors still surface because set -e fires on
# non-zero exit, and stderr is preserved for any step that prints to it.
DEPLOY_SILENT=0
say() {
  if [ "$DEPLOY_SILENT" != "1" ]; then
    echo "$@"
  fi
}

DEPLOY_ENV_FILE="$DIR/.deploy-env"
if [ -f "$DEPLOY_ENV_FILE" ]; then
  DEPLOY_ENV=$(cat "$DEPLOY_ENV_FILE" | tr -d '[:space:]')
else
  DEPLOY_ENV="dev"
fi

require_non_production() {
  if [ "$DEPLOY_ENV" = "production" ]; then
    echo "ERROR: '$1' is disabled in production environment."
    echo "To change, run: ./deploy setup-dev"
    exit 1
  fi
}

detect_host_lan_ip() {
  # macOS
  if command -v ipconfig >/dev/null 2>&1; then
    for iface in en0 en1 en2 en3; do
      ip=$(ipconfig getifaddr "$iface" 2>/dev/null || true)
      if [ -n "$ip" ] && [[ "$ip" != 127.* ]]; then
        echo "$ip"; return 0
      fi
    done
  fi
  # Linux
  ip route get 8.8.8.8 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}'
}

if [ -z "${PUBLIC_SERVER_URL:-}" ]; then
  HOST_LAN_IP=$(detect_host_lan_ip)
  if [ -n "$HOST_LAN_IP" ]; then
    export PUBLIC_SERVER_URL="http://${HOST_LAN_IP}:8080"
  fi
fi

# Cloudflare Tunnel (optional, per-host). When .tunnel.env with a TUNNEL_TOKEN is
# present, enable the "tunnel" compose profile so `dc up -d` also starts the
# cloudflared sidecar automatically. Absent on localhost => nothing happens.
if [ -f "$DIR/.tunnel.env" ]; then
  set -a; . "$DIR/.tunnel.env"; set +a
  if [ -n "${TUNNEL_TOKEN:-}" ]; then
    export TUNNEL_TOKEN
    export COMPOSE_PROFILES="${COMPOSE_PROFILES:+$COMPOSE_PROFILES,}tunnel"
  fi
fi

# Extra apps config: apps.json in repo root.
# [{ "name": ..., "repo": ..., "branch": ..., "enabled": true }]
extra_apps_enabled() {
  [ -f "$DIR/apps.json" ] || return 0
  python3 -c "import json; print(' '.join(a['name'] for a in json.load(open('$DIR/apps.json')) if a.get('enabled')))"
}

extra_apps_disabled() {
  [ -f "$DIR/apps.json" ] || return 0
  python3 -c "import json; print(' '.join(a['name'] for a in json.load(open('$DIR/apps.json')) if not a.get('enabled')))"
}

dc() {
  if docker compose version &>/dev/null; then
    docker compose -p docker -f "$DIR/docker-compose.yml" "$@"
  else
    docker-compose -p docker -f "$DIR/docker-compose.yml" "$@"
  fi
}

# --- Ops dashboard -----------------------------------------------------------
# The ops dashboard is a SEPARATE compose project on purpose. `run_deploy` runs
# `dc up -d`, which recreates every container in the "docker" project — if ops
# lived there, a deploy launched from the dashboard would kill the very process
# streaming its own console output. Keeping it under -p ops makes it invisible
# to dc() (and to `dc down -v` in nuke/destroy).
OPS_COMPOSE_FILE="$DIR/docker-compose.ops.yml"
OPS_LOCAL_COMPOSE_FILE="$DIR/docker-compose.ops.local.yml"

ops_dc() {
  [ -f "$OPS_COMPOSE_FILE" ] || return 0
  local files=(-f "$OPS_COMPOSE_FILE")
  # Developer setup: no sshd needed, ops runs commands on itself instead —
  # see docker-compose.ops.local.yml.
  if [ "${OPS_LOCAL_MODE:-}" = "1" ]; then
    files+=(-f "$OPS_LOCAL_COMPOSE_FILE")
  fi
  # Every subcommand (build included, not just up) needs OPS_SESSION_SECRET
  # etc. for compose's variable interpolation — source in a subshell so
  # .ops.env never leaks into the ERPNext deploy environment above this.
  (
    set -a
    [ -f "$DIR/.ops.env" ] && . "$DIR/.ops.env"
    set +a
    if docker compose version &>/dev/null; then
      docker compose -p ops "${files[@]}" "$@"
    else
      docker-compose -p ops "${files[@]}" "$@"
    fi
  )
}

# Opt-in per host: no .ops.env means this machine does not run the dashboard.
ops_enabled() {
  [ -f "$DIR/.ops.env" ] && [ -f "$OPS_COMPOSE_FILE" ]
}

# Never allowed to abort an ERPNext deploy: the subshell keeps .ops.env out of
# the deploy environment, and the `|| echo` keeps `set -e` from propagating an
# ops-side failure into the caller.
ops_up() {
  ops_enabled || return 0
  say "==> Starting ops dashboard (project: ops)..."
  (
    set -a
    . "$DIR/.ops.env"
    set +a
    if [ "${OPS_LOCAL_MODE:-}" != "1" ]; then
      : "${OPS_SSH_HOST:=$(detect_host_lan_ip)}"
      export OPS_SSH_HOST
    fi
    ops_dc up -d --build
  ) || echo "WARNING: ops dashboard failed to start (ERPNext deploy unaffected)."
}

wait_for_db() {
  say "==> Waiting for MariaDB..."
  for i in $(seq 1 30); do
    if dc exec -T db mysqladmin ping --password=admin 2>/dev/null | grep -q alive; then
      say "==> MariaDB is ready."
      return 0
    fi
    sleep 2
  done
  echo "ERROR: MariaDB not ready after 60s. Check: dc logs db"
  exit 1
}

wait_for_backend() {
  say "==> Waiting for backend..."
  for i in $(seq 1 30); do
    if dc exec -T backend bench --site frontend doctor 2>/dev/null | grep -q "OK" 2>/dev/null || \
       dc exec -T backend python3 -c "import frappe" 2>/dev/null; then
      return 0
    fi
    sleep 2
  done
  echo "WARNING: Backend may not be fully ready after 60s, proceeding anyway."
}

build_image() {
  # Hash the remote HEAD of every app in apps.json so the Docker clone layer is
  # invalidated whenever any fork moves (otherwise the clone is cached forever and
  # fork pushes never reach the image). Empty/offline -> stable 0, layer stays cached.
  local apps_bust="0"
  if [ -f "$DIR/apps.json" ]; then
    apps_bust=$(python3 -c "import json;[print(a['repo'],a['branch']) for a in json.load(open('$DIR/apps.json'))]" \
      | while read -r repo branch; do git ls-remote "$repo" "$branch" 2>/dev/null | awk '{print $1}'; done \
      | cksum | awk '{print $1}')
    [ -n "$apps_bust" ] || apps_bust="0"
  fi
  say "==> Extra-apps cache key: $apps_bust"
  say "==> Building full image (all source baked in)..."
  docker build --build-arg "ERPNEXT_VERSION=$ERPNEXT_VERSION" \
    --build-arg "APPS_CACHE_BUST=$apps_bust" \
    -t "$IMAGE_NAME" -f "$DIR/Dockerfile.full" "$DIR" || return 1
  say "==> Pruning dangling images..."
  docker image prune -f --filter "dangling=true" >/dev/null
}

sync_built_assets() {
  # The image only carries sites/assets when the Dockerfile happened to leave it
  # there; normally the directory is created at runtime and the built bundles
  # live under apps/*/public/dist. Without this guard tar reads an empty stream,
  # fails, and `set -e` kills the whole deploy before migrate and fix_assets ever
  # run — silently, because --silent routes the error to /dev/null.
  if ! docker run --rm --entrypoint test "$IMAGE_NAME" \
       -d /home/frappe/frappe-bench/sites/assets 2>/dev/null; then
    say "==> Image carries no sites/assets — skipping (bundles come from apps/*/public/dist)."
    return 0
  fi

  say "==> Syncing built assets from image to sites volume..."
  # --entrypoint tar: the image entrypoint prints "Linking fresh assets to volume..."
  # on stdout, which corrupts the tar stream piped into the backend container.
  docker run --rm --entrypoint tar "$IMAGE_NAME" -cf - --ignore-failed-read \
    -C /home/frappe/frappe-bench/sites/assets \
    frappe erpnext $(extra_apps_enabled) locale assets.json assets-rtl.json 2>/dev/null | \
    dc exec -T -u root backend tar -xf - -C /home/frappe/frappe-bench/sites/assets/ || {
      echo "WARNING: asset sync from image failed — manifest check will rebuild if needed"
      return 0
    }
  dc exec -T -u root backend chown -R frappe:frappe /home/frappe/frappe-bench/sites/assets/
  say "==> Assets synced."
}

# sites/assets/assets.json maps bundle -> hashed filename and is what every page
# renders its <link>/<script> tags from. It lives in the *sites volume*, which
# survives image rebuilds, while the hashed bundles themselves ship inside the
# image under apps/*/public/dist. The image has no sites/assets directory at all
# (it is created at runtime), so sync_built_assets cannot refresh the manifest —
# a rebuild leaves the old manifest pointing at hashes that no longer exist and
# nginx answers every asset request with its 404 HTML page ("Refused to apply
# style ... MIME type ('text/html')"). Detect that and regenerate with a full
# `bench build`; a partial --app build rewrites hashes for every app while
# rebuilding only one, which is worse than doing nothing.
ensure_assets_manifest() {
  say "==> Verifying asset manifest..."
  if dc exec -T backend bash -c 'cd /home/frappe/frappe-bench/sites && python3 -c "
import json, os, sys

try:
    with open(\"assets/assets.json\") as f:
        manifest = json.load(f)
except Exception as exc:
    print(f\"unreadable: {exc}\")
    sys.exit(1)

missing = [
    path
    for path in manifest.values()
    if path.startswith(\"/assets/\") and not os.path.exists(path.lstrip(\"/\"))
]
if missing:
    print(f\"{len(missing)} of {len(manifest)} bundles missing, e.g. {missing[0]}\")
    sys.exit(1)
print(f\"{len(manifest)} bundles OK\")
"' 2>/dev/null; then
    return 0
  fi

  say "==> Manifest is stale — running bench build (this takes a few minutes)..."
  if [ "$DEPLOY_SILENT" = "1" ]; then
    dc exec -T backend bench build >/dev/null 2>&1
  else
    dc exec -T backend bench build
  fi
  say "==> Assets rebuilt."
}

fix_assets() {
  say "==> Syncing assets from backend to frontend container..."
  FRONTEND_CID=$(dc ps -q frontend 2>/dev/null)
  BACKEND_CID=$(dc ps -q backend 2>/dev/null)
  if [ -z "$FRONTEND_CID" ] || [ -z "$BACKEND_CID" ]; then
    echo "WARNING: frontend or backend container not running, skipping asset sync"
    return 0
  fi

  for i in $(seq 1 15); do
    if docker exec "$BACKEND_CID" test -f /home/frappe/frappe-bench/sites/assets/assets.json 2>/dev/null && \
       docker exec "$FRONTEND_CID" test -d /home/frappe/frappe-bench/sites/assets 2>/dev/null; then
      break
    fi
    [ "$i" = "15" ] && echo "WARNING: containers not fully ready after 30s, attempting sync anyway"
    sleep 2
  done

  local ASSET_APPS="frappe erpnext"
  local ASSET_RM="rm -rf /home/frappe/frappe-bench/sites/assets/frappe /home/frappe/frappe-bench/sites/assets/erpnext"
  for extra_app in $(extra_apps_enabled) insights; do
    if docker exec "$BACKEND_CID" test -d "/home/frappe/frappe-bench/sites/assets/$extra_app" 2>/dev/null; then
      ASSET_APPS="$ASSET_APPS $extra_app"
      ASSET_RM="$ASSET_RM /home/frappe/frappe-bench/sites/assets/$extra_app"
    fi
  done

  for attempt in 1 2 3; do
    docker exec -u root "$FRONTEND_CID" bash -c "$ASSET_RM" 2>/dev/null

    if docker exec "$BACKEND_CID" tar -chf - -C /home/frappe/frappe-bench/sites/assets $ASSET_APPS assets.json assets-rtl.json | \
       docker exec -u root -i "$FRONTEND_CID" tar -xf - -C /home/frappe/frappe-bench/sites/assets/; then
      if docker exec "$FRONTEND_CID" test -f /home/frappe/frappe-bench/sites/assets/assets.json 2>/dev/null; then
        say "==> Asset sync complete."
        dc exec -T backend bench --site frontend console <<'PY' 2>/dev/null
import frappe
frappe.cache.delete_value("assets_json", shared=True)
PY
        say "==> Flushed assets_json from Redis cache."
        return 0
      fi
    fi

    echo "WARNING: Asset sync attempt $attempt failed, retrying in 3s..."
    sleep 3
  done

  echo "ERROR: Asset sync failed after 3 attempts. Run './deploy fix-assets' to retry manually."
  return 1
}

apply_site_config() {
  SITE_CONFIG="$DIR/site-config.json"
  if [ ! -f "$SITE_CONFIG" ]; then
    return
  fi
  GLOBAL_KEYS="server_script_enabled"
  for key in $(python3 -c "import json; d=json.load(open('$SITE_CONFIG')); [print(k) for k in d]"); do
    value=$(python3 -c "import json; print(json.load(open('$SITE_CONFIG'))['$key'])")
    if echo " $GLOBAL_KEYS " | grep -q " $key "; then
      dc exec -T backend bench set-config -g "$key" "$value"
    else
      dc exec -T backend bench --site frontend set-config "$key" "$value"
    fi
  done
}

# --- Backups -----------------------------------------------------------------
# Backups live inside the sites volume, i.e. on the same disk as everything
# else. A --with-files set is ~2.7GB (2.5GB of that is regenerable PJ-*.png
# label renders), so retention and the free-space guard are not optional.
SITE="frontend"
BACKUP_DIR="/home/frappe/frappe-bench/sites/$SITE/private/backups"
OPS_BACKUP_KEEP="${OPS_BACKUP_KEEP:-5}"

# One line per backup *set*: "<name> <epoch> <total-bytes>", oldest first.
# A set is every file sharing the "<timestamp>-<site>" prefix.
backup_list() {
  dc exec -T backend bash -c '
    d="$1"
    [ -d "$d" ] || exit 0
    for f in "$d"/*-database.sql.gz; do
      [ -e "$f" ] || continue
      b=$(basename "$f"); n=${b%-database.sql.gz}
      sz=$(du -cb "$d/$n"-* 2>/dev/null | tail -1 | cut -f1)
      ts=$(stat -c %Y "$f")
      echo "$n $ts $sz"
    done | sort -k2 -n
  ' _ "$BACKUP_DIR" </dev/null 2>/dev/null
}

backup_list_human() {
  backup_list | awk '{printf "  %-26s %s  %.1f MB\n", $1, strftime("%Y-%m-%d %H:%M", $2), $3/1048576}'
}

# Sidecar written next to a freshly created backup set so a later push/pull can
# tell which ERPNext version produced it and whether it was prod or dev.
backup_meta_json() {
  local name="$1" branch head tag describe env_label with_files created_at
  branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
  head=$(git rev-parse --short HEAD 2>/dev/null)
  tag=$(git tag --points-at HEAD 2>/dev/null | tail -1)
  describe=$(git describe --tags --always --dirty 2>/dev/null)
  env_label=$([ "$DEPLOY_ENV" = "production" ] && echo prod || echo dev)
  with_files=$(dc exec -T backend test -f "$BACKUP_DIR/$name-files.tar" </dev/null 2>/dev/null && echo true || echo false)
  created_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  printf '{"name":"%s","created_at":"%s","site":"%s","env_label":"%s","erpnext":{"branch":"%s","tag":"%s","head":"%s","describe":"%s"},"with_files":%s}\n' \
    "$name" "$created_at" "$SITE" "$env_label" "$branch" "$tag" "$head" "$describe" "$with_files"
}

backup_write_meta() {
  local name="$1"
  backup_meta_json "$name" | dc exec -T backend tee "$BACKUP_DIR/$name-meta.json" >/dev/null
}

# Unconditional delete of one named local backup set, independent of
# backup_prune's keep-count logic — used once a set is confirmed pushed
# off-host (backup-scheduled) so it does not also eat a local retention slot.
backup_delete_local() {
  local name="$1"
  dc exec -T backend bash -c 'rm -f "$1/$2"-*' _ "$BACKUP_DIR" "$name" </dev/null
}

# Plain FTP, not SFTP: this target (confirmed against a real Tucha hosting
# account) speaks FTP with opportunistic explicit TLS, default port 21 — no
# SSH involved. Every curl call here uses --ssl (curl's "use TLS if the
# server offers it" flag), matching the client config that was verified to
# actually work; --ssl-reqd would be stricter but risks breaking on a target
# that doesn't support TLS on every command channel. Also -k: Tucha's TLS
# cert doesn't chain to a CA curl trusts (curl 60), and there's no pinned
# fingerprint to check against instead — same trust-on-first-use gap as the
# rest of this feature, just for TLS instead of SSH host keys.
#
# Uploads one backup set's files (+ its meta.json) to the FTP target and
# refreshes manifest.json there. The db dump and meta.json are required — a
# failed upload of either aborts with non-zero; file tarballs are uploaded
# when present locally but their absence is not an error.
backup_push_files() {
  local name="$1" rhost="$2" rport="$3" rdir="$4" netrc="$5"
  local suffix f required
  for suffix in database.sql.gz meta.json files.tar private-files.tar; do
    f="$BACKUP_DIR/$name-$suffix"
    dc exec -T backend test -f "$f" </dev/null || continue
    case "$suffix" in
      database.sql.gz | meta.json) required=1 ;;
      *) required=0 ;;
    esac
    if ! dc exec -T backend curl -sS -f -k --ssl --netrc-file "$netrc" -T "$f" \
      "ftp://$rhost:$rport$rdir/$name-$suffix" </dev/null; then
      if [ "$required" = "1" ]; then
        echo "ERROR: upload of $name-$suffix failed."
        return 1
      fi
      echo "WARNING: upload of $name-$suffix failed (optional, continuing)."
    fi
  done

  dc exec -T backend bash -c '
    RHOST="$1"; RPORT="$2"; RDIR="$3"; NETRC="$4"; NAME="$5"; BACKUP_DIR="$6"
    TMP=$(mktemp)
    curl -sS -k --ssl --netrc-file "$NETRC" "ftp://$RHOST:$RPORT$RDIR/manifest.json" -o "$TMP" 2>/dev/null || echo "[]" > "$TMP"
    python3 -c "
import json, sys
path, name, meta_path = sys.argv[1], sys.argv[2], sys.argv[3]
try:
    entries = json.load(open(path))
    if not isinstance(entries, list):
        entries = []
except Exception:
    entries = []
entries = [e for e in entries if e.get(\"name\") != name]
meta = json.load(open(meta_path))
entries.append(meta)
entries.sort(key=lambda e: e.get(\"created_at\", \"\"))
json.dump(entries, open(path, \"w\"))
" "$TMP" "$NAME" "$BACKUP_DIR/$NAME-meta.json"
    curl -sS -f -k --ssl --netrc-file "$NETRC" -T "$TMP" "ftp://$RHOST:$RPORT$RDIR/manifest.json"
    RC=$?
    rm -f "$TMP"
    exit $RC
  ' _ "$rhost" "$rport" "$rdir" "$netrc" "$name" "$BACKUP_DIR" </dev/null
}

backup_prune() {
  local keep="${1:-$OPS_BACKUP_KEEP}"
  local names
  if [ "$keep" -le 0 ]; then
    names=$(backup_list | awk '{print $1}')
  else
    names=$(backup_list | awk '{print $1}' | head -n "-$keep")
  fi
  [ -n "$names" ] || return 0
  for n in $names; do
    say "==> Pruning old backup $n"
    dc exec -T backend bash -c 'rm -f "$1/$2"-*' _ "$BACKUP_DIR" "$n" </dev/null
  done
}

# Refuse to start a backup that would not fit: needs 2x the largest existing
# set, with a 4GB floor when there is nothing to measure against.
backup_space_guard() {
  local free need
  free=$(dc exec -T backend df -B1 --output=avail "$BACKUP_DIR" </dev/null 2>/dev/null | tail -1 | tr -d '[:space:]')
  case "$free" in ''|*[!0-9]*) return 0 ;; esac
  need=$(backup_list | awk '{if($3>m)m=$3}END{print (m?m*2:4294967296)}')
  if [ "$free" -lt "$need" ]; then
    echo "ERROR: only $((free/1024/1024))MB free at $BACKUP_DIR, need ~$((need/1024/1024))MB."
    echo "Free space first:  ./deploy backup --prune-only --keep=1"
    exit 1
  fi
}

strip_extra_apps() {
  say "==> Removing extra apps before migrate..."
  dc exec -T backend bash -c "sed -i '/^insights$/d' /home/frappe/frappe-bench/sites/apps.txt" 2>/dev/null || true
  local DB_NAME
  DB_NAME=$(dc exec -T backend bash -c "cat /home/frappe/frappe-bench/sites/*/site_config.json" 2>/dev/null \
    | python3 -c "import sys,json; print(json.load(sys.stdin).get('db_name',''))" 2>/dev/null) || true
  if [ -n "$DB_NAME" ]; then
    dc exec -T db mysql -uroot -padmin "$DB_NAME" -e "
      UPDATE tabDefaultValue
      SET defvalue = REPLACE(REPLACE(REPLACE(defvalue,
          ', \"insights\"', ''), '\"insights\", ', ''), '\"insights\"', '')
      WHERE parent = '__global'
      AND parentfield = 'system_defaults'
      AND defkey = 'installed_apps'
      AND defvalue LIKE '%insights%';
      DELETE FROM \`tabInstalled Application\` WHERE app_name = 'insights';
    " 2>/dev/null || true
  fi
  dc exec -T redis-cache redis-cli FLUSHALL 2>/dev/null || true
}

ensure_extra_apps() {
  local app
  for app in $(extra_apps_enabled); do
    say "==> Ensuring $app is installed on site..."
    dc exec -T backend bash -c "grep -qx '$app' /home/frappe/frappe-bench/sites/apps.txt || echo $app >> /home/frappe/frappe-bench/sites/apps.txt"
    if [ "$DEPLOY_SILENT" = "1" ]; then
      dc exec -T backend bench --site frontend install-app "$app" --force >/dev/null 2>&1 || true
    else
      dc exec -T backend bench --site frontend install-app "$app" --force 2>&1 | grep -v "^Updating DocTypes\|already installed"
    fi
  done
  for app in $(extra_apps_disabled); do
    if dc exec -T backend bench --site frontend list-apps 2>/dev/null | grep -qx "$app"; then
      echo "==> App '$app' is disabled in apps.json but installed on site."
      echo "    Uninstalling — this DELETES all data of $app DocTypes from the DB."
      dc exec -T backend bench --site frontend uninstall-app "$app" --yes --no-backup 2>&1 | tail -3
      dc exec -T backend bash -c "sed -i '/^$app\$/d' /home/frappe/frappe-bench/sites/apps.txt"
    fi
  done
}

install_extra_apps() {
  ensure_extra_apps
  "$DIR/insights" auto || true
  fix_assets
  dc exec -T backend bench --site frontend clear-cache 2>/dev/null || true
}

run_deploy() {
  local SILENT="${1:-0}"

  local out="/dev/stdout"
  local err="/dev/stderr"
  if [ "$SILENT" = "1" ]; then
    out="/dev/null"
    err="/dev/null"
  fi

  say "==> Recreating containers with new image..."
  dc up -d > "$out" 2>&1

  say "==> Waiting for configurator to finish..."
  dc wait configurator > "$out" 2>&1 || sleep 5

  sync_built_assets > "$out" 2>&1

  say "==> Applying site config..."
  apply_site_config > "$out" 2>&1

  wait_for_db > "$out" 2>&1

  strip_extra_apps > "$out" 2>&1

  say "==> Running bench migrate..."
  dc exec -T backend bench --site frontend migrate > "$out" 2>&1

  say "==> Running setup_custom_fields..."
  if [ "$SILENT" = "1" ]; then
    dc exec -T backend bench --site frontend execute erpnext.patches.setup_custom_fields.execute >/dev/null 2>&1 || true
  else
    dc exec -T backend bench --site frontend execute erpnext.patches.setup_custom_fields.execute
  fi

  say "==> Clearing cache..."
  dc exec -T backend bench --site frontend clear-cache > "$out" 2>&1

  # Advisory only: lists DocTypes that exist solely in this site's database
  # (created through the desk UI, custom=1) and never reach git or the image.
  # Graduate one with ./codify. Never fails the deploy.
  dc exec -T backend bench --site frontend execute erpnext.utilities.doctype_drift.report || true

  # Must run before install_extra_apps: that is what copies assets to the
  # frontend (nginx) container and flushes assets_json from Redis, so the
  # manifest has to be correct by then.
  ensure_assets_manifest

  install_extra_apps > "$out" 2>&1

  echo "Done. http://localhost:8080"
}

case "${1:-}" in
  nuke)
    require_non_production "nuke"
    say "==> Stopping containers and removing all data..."
    dc down -v
    # No -v: nuke resets ERPNext data, not the dashboard's known_hosts/lockout state.
    ops_dc down 2>/dev/null || true
    echo "All data has been removed."
    ;;

  init)
    build_image

    say "==> Starting ERPNext..."
    dc up -d
    sync_built_assets

    say "==> Waiting for site to be ready (2-3 min)..."
    until dc exec -T backend bench --site frontend list-apps 2>/dev/null | grep -q erpnext; do
      sleep 5
    done

    for app in $(extra_apps_enabled); do
      say "==> Installing $app on site..."
      dc exec -T backend bench --site frontend install-app "$app"
    done

    say "==> Enabling Ukrainian language..."
    dc exec -T backend bench --site frontend console <<'PY'
import frappe
if not frappe.db.exists("Language", "uk"):
    frappe.get_doc({"doctype": "Language", "language_code": "uk", "language_name": "Українська", "enabled": 1}).insert(ignore_permissions=True)
    frappe.db.commit()
PY
    say "==> Applying site config..."
    apply_site_config

    dc exec -T backend bench --site frontend clear-cache

    "$DIR/insights" auto || true
    fix_assets
    ops_up

    echo ""
    echo "Ready at http://localhost:8080  (Administrator / admin)"
    echo "Switch language: Settings -> Language -> Українська"
    ;;

  start)
    dc up -d
    say "==> Waiting for configurator to finish..."
    dc wait configurator 2>/dev/null || sleep 5
    sync_built_assets
    say "==> Applying site config..."
    apply_site_config
    wait_for_db
    install_extra_apps
    ops_up
    echo "Started at http://localhost:8080"
    if [ "${2:-}" = "--logs" ]; then
      dc logs -f --since 0s
    fi
    ;;

  stop)
    dc stop
    ops_dc stop 2>/dev/null || true
    ;;

  build)
    SILENT=0
    for arg in "$@"; do [ "$arg" = "--silent" ] && SILENT=1; done
    DEPLOY_SILENT=$SILENT

    if [ "$SILENT" = "1" ]; then
      # Stream build to a temp log so we can show context only if it fails.
      BUILD_LOG=$(mktemp)
      trap "rm -f $BUILD_LOG" EXIT
      if ! build_image > "$BUILD_LOG" 2>&1; then
        echo "ERROR: docker build failed. Last 30 lines:"
        tail -30 "$BUILD_LOG"
        exit 1
      fi
    else
      build_image
    fi
    run_deploy "$SILENT"
    # Outside run_deploy on purpose: inside, --silent routes stdout to /dev/null
    # and an ops failure would be invisible.
    ops_up

    if [ "${2:-}" = "--logs" ] || [ "${3:-}" = "--logs" ]; then
      dc logs -f --since 0s
    fi
    ;;

  migrate)
    SILENT=0
    for arg in "$@"; do [ "$arg" = "--silent" ] && SILENT=1; done
    DEPLOY_SILENT=$SILENT

    say "(migrate is now an alias for build)"
    if [ "$SILENT" = "1" ]; then
      BUILD_LOG=$(mktemp)
      trap "rm -f $BUILD_LOG" EXIT
      if ! build_image > "$BUILD_LOG" 2>&1; then
        echo "ERROR: docker build failed. Last 30 lines:"
        tail -30 "$BUILD_LOG"
        exit 1
      fi
    else
      build_image
    fi
    run_deploy "$SILENT"
    ops_up
    ;;

  destroy)
    require_non_production "destroy"
    dc down -v
    ops_dc down 2>/dev/null || true
    echo "Stopped and removed all data."
    ;;

  setup-prod)
    echo "production" > "$DEPLOY_ENV_FILE"
    echo "Environment set to production. Destructive commands (nuke, destroy) are now disabled."
    ;;

  setup-dev)
    echo "dev" > "$DEPLOY_ENV_FILE"
    echo "Environment set to dev. All commands available."
    ;;

  fix-assets)
    fix_assets
    ;;

  ops)
    case "${2:-}" in
      up|"")   ops_up ;;
      down)    ops_dc down ;;
      rebuild) ops_dc build --no-cache && ops_up ;;
      logs)    ops_dc logs -f --since 0s ;;
      status)  ops_dc ps ;;
      *)
        echo "Usage: ./deploy ops {up|down|rebuild|logs|status}"
        exit 1
        ;;
    esac
    ;;

  backup)
    WITH_FILES=1
    PRUNE_ONLY=0
    KEEP="$OPS_BACKUP_KEEP"
    for arg in "$@"; do
      case "$arg" in
        --with-files) WITH_FILES=1 ;;
        --no-files)   WITH_FILES=0 ;;
        --prune-only) PRUNE_ONLY=1 ;;
        --keep=*)     KEEP="${arg#--keep=}" ;;
      esac
    done

    if [ "$PRUNE_ONLY" = "1" ]; then
      backup_prune "$KEEP"
      echo "Pruned to last $KEEP. Remaining:"
      backup_list_human
      exit 0
    fi

    # Prune BEFORE taking the new one. On a disk this full, writing a ~2.7GB
    # backup and only then deleting the oldest is exactly backwards.
    backup_prune "$((KEEP - 1))"
    backup_space_guard

    say "==> Backing up site $SITE..."
    if [ "$WITH_FILES" = "1" ]; then
      dc exec -T backend bench --site "$SITE" backup --with-files
    else
      dc exec -T backend bench --site "$SITE" backup
    fi
    NEW_NAME=$(backup_list | tail -1 | awk '{print $1}')
    [ -n "$NEW_NAME" ] && backup_write_meta "$NEW_NAME"
    echo "Backups (keeping last $KEEP):"
    backup_list_human
    ;;

  restore)
    NAME="${2:-}"
    CONFIRM=0
    for arg in "$@"; do [ "$arg" = "--yes" ] && CONFIRM=1; done

    if [ -z "$NAME" ] || [ "$NAME" = "--list" ]; then
      echo "Available backups:"
      backup_list_human
      echo ""
      echo "Usage: ./deploy restore <name> [--yes]"
      exit 0
    fi

    if ! dc exec -T backend test -f "$BACKUP_DIR/$NAME-database.sql.gz" </dev/null; then
      echo "ERROR: no backup named '$NAME'. Try: ./deploy restore --list"
      exit 1
    fi

    echo "!! RESTORE DESTROYS THE CURRENT DATABASE AND FILES OF SITE '$SITE' ON '$DEPLOY_ENV'."
    echo "!! Backup: $NAME"
    if [ "$CONFIRM" != "1" ]; then
      # Fails without a tty by design: the ops dashboard must pass --yes and do
      # its own typed confirmation server-side.
      printf "Type the site name (%s) to proceed: " "$SITE"
      read -r ANSWER </dev/tty
      [ "$ANSWER" = "$SITE" ] || { echo "Aborted."; exit 1; }
    fi

    say "==> Taking a pre-restore safety backup..."
    dc exec -T backend bench --site "$SITE" backup || true

    RESTORE_ARGS="$BACKUP_DIR/$NAME-database.sql.gz"
    # --with-public-files/--with-private-files take a path argument in v15;
    # passing them bare fails, so only append when the tarball exists.
    if dc exec -T backend test -f "$BACKUP_DIR/$NAME-files.tar" </dev/null; then
      RESTORE_ARGS="$RESTORE_ARGS --with-public-files $BACKUP_DIR/$NAME-files.tar"
    fi
    if dc exec -T backend test -f "$BACKUP_DIR/$NAME-private-files.tar" </dev/null; then
      RESTORE_ARGS="$RESTORE_ARGS --with-private-files $BACKUP_DIR/$NAME-private-files.tar"
    fi

    say "==> Restoring $NAME..."
    # Root creds match docker-compose.yml; without them restore prompts and
    # hangs under `exec -T`.
    dc exec -T backend bench --site "$SITE" --force restore $RESTORE_ARGS \
      --db-root-username root --db-root-password admin

    # Mandatory: a restored DB carries the old assets.json state, which is the
    # "MIME type ('text/html')" breakage ensure_assets_manifest exists to fix.
    say "==> Migrating and rebuilding assets after restore..."
    dc exec -T backend bench --site "$SITE" migrate
    dc exec -T backend bench --site "$SITE" clear-cache
    ensure_assets_manifest
    fix_assets
    echo "Restore complete."
    ;;

  backup-push)
    # Push one existing local backup set (+ its meta.json) to an off-host FTP
    # target, then refresh that target's manifest.json. Credentials never
    # appear here — they live only in the caller-supplied netrc file, read by
    # curl, never by this script.
    NAME="${2:?usage: ./deploy backup-push <name> <host> <port> <remote-dir> <netrc-file>}"
    RHOST="${3:?}"; RPORT="${4:?}"; RDIR="${5:?}"; NETRC="${6:?}"
    trap 'dc exec -T backend rm -f "$NETRC" 2>/dev/null || true' EXIT
    for f in "$BACKUP_DIR/$NAME-database.sql.gz" "$BACKUP_DIR/$NAME-meta.json"; do
      if ! dc exec -T backend test -f "$f" </dev/null; then
        echo "ERROR: missing $f locally, cannot push."
        exit 1
      fi
    done
    say "==> Pushing $NAME to ftp://$RHOST:$RPORT$RDIR/ ..."
    if backup_push_files "$NAME" "$RHOST" "$RPORT" "$RDIR" "$NETRC"; then
      echo "Push complete: $NAME"
    else
      echo "ERROR: push failed for $NAME."
      exit 1
    fi
    ;;

  backup-remote-list)
    RHOST="${2:?usage: ./deploy backup-remote-list <host> <port> <remote-dir> <netrc-file>}"
    RPORT="${3:?}"; RDIR="${4:?}"; NETRC="${5:?}"
    trap 'dc exec -T backend rm -f "$NETRC" 2>/dev/null || true' EXIT
    dc exec -T backend curl -sS -k --ssl --netrc-file "$NETRC" "ftp://$RHOST:$RPORT$RDIR/manifest.json" 2>/dev/null || echo "[]"
    ;;

  backup-remote-test)
    # A trailing slash on the ftp:// URL makes curl LIST the directory
    # instead of fetching a file — used by the ops "Test connection" button
    # to prove the target is reachable, and to surface what's already there.
    # Unlike push/pull/list, this touches no backup files, so it runs curl on
    # the host directly rather than through the backend container — the test
    # then works even with the ERPNext stack stopped. NETRC lives on the host
    # only for the few seconds of this call (ops writes it, we delete it).
    RHOST="${2:?usage: ./deploy backup-remote-test <host> <port> <remote-dir> <netrc-file>}"
    RPORT="${3:?}"; RDIR="${4:?}"; NETRC="${5:?}"
    trap 'rm -f "$NETRC"' EXIT
    curl -sS -f -k --ssl --netrc-file "$NETRC" "ftp://$RHOST:$RPORT$RDIR/"
    ;;

  backup-pull)
    NAME="${2:?usage: ./deploy backup-pull <name> <host> <port> <remote-dir> <netrc-file>}"
    RHOST="${3:?}"; RPORT="${4:?}"; RDIR="${5:?}"; NETRC="${6:?}"
    trap 'dc exec -T backend rm -f "$NETRC" 2>/dev/null || true' EXIT
    say "==> Pulling $NAME from ftp://$RHOST:$RPORT$RDIR/ ..."
    for suffix in database.sql.gz meta.json files.tar private-files.tar; do
      dc exec -T backend bash -c '
        RHOST="$1"; RPORT="$2"; RDIR="$3"; NETRC="$4"; NAME="$5"; SUFFIX="$6"; BACKUP_DIR="$7"
        OUT="$BACKUP_DIR/$NAME-$SUFFIX"
        TMP=$(mktemp)
        if curl -sS -f -k --ssl --netrc-file "$NETRC" "ftp://$RHOST:$RPORT$RDIR/$NAME-$SUFFIX" -o "$TMP" 2>/dev/null; then
          mv "$TMP" "$OUT"
        else
          rm -f "$TMP"
        fi
      ' _ "$RHOST" "$RPORT" "$RDIR" "$NETRC" "$NAME" "$suffix" "$BACKUP_DIR" </dev/null
    done
    if ! dc exec -T backend test -f "$BACKUP_DIR/$NAME-database.sql.gz" </dev/null; then
      echo "ERROR: pull failed, no database dump landed for $NAME."
      exit 1
    fi
    echo "Pull complete: $NAME. Restore with: ./deploy restore $NAME"
    ;;

  backup-remove)
    # Unconditional single-set delete — the "Remove" row action in the ops
    # dashboard's 3-dot menu. Independent of retention (backup_prune); the
    # operator picked this exact set.
    NAME="${2:?usage: ./deploy backup-remove <name>}"
    if ! dc exec -T backend test -f "$BACKUP_DIR/$NAME-database.sql.gz" </dev/null; then
      echo "ERROR: no backup named '$NAME'."
      exit 1
    fi
    backup_delete_local "$NAME"
    echo "Removed: $NAME"
    ;;

  backup-scheduled)
    # Cron's entry point (installed/removed by the ops dashboard's Settings
    # page over the operator's own SSH session — nothing runs unattended that
    # a human did not configure interactively). Takes a full local backup,
    # then — if an FTP target is configured — pushes it, confirms it landed
    # in the remote manifest, and only then deletes the local copy: a
    # scheduled backup is not meant to also eat a local retention slot.
    #
    # The FTP password is fetched from the already-running ops container
    # (which holds it encrypted) via `docker compose exec`, never written to
    # a host-side file: this script's own argv never carries it, only a
    # captured-in-memory JSON blob and a netrc file scoped to this run.
    TARGET_ID="${2:-}"

    say "==> Scheduled backup for site $SITE..."
    backup_prune "$((OPS_BACKUP_KEEP - 1))"
    backup_space_guard
    dc exec -T backend bench --site "$SITE" backup --with-files
    NEW_NAME=$(backup_list | tail -1 | awk '{print $1}')
    if [ -z "$NEW_NAME" ]; then
      echo "ERROR: scheduled backup produced no new set."
      exit 1
    fi
    backup_write_meta "$NEW_NAME"

    if [ -z "$TARGET_ID" ]; then
      echo "Scheduled as local-only (no push target selected); backup stays local: $NEW_NAME"
      exit 0
    fi

    if ! ops_enabled; then
      echo "Ops dashboard not enabled on this host; backup stays local: $NEW_NAME"
      exit 0
    fi

    CREDS_JSON=$(ops_dc exec -T ops python3 -c '
import json, sys
from app.ftp_config import get_target
c = get_target(sys.argv[1])
print(json.dumps({"host": c.host, "port": c.port, "username": c.username, "password": c.password, "remote_dir": c.remote_dir}) if c else "")
' "$TARGET_ID" 2>/dev/null)
    if [ -z "$CREDS_JSON" ]; then
      echo "ERROR: configured push target '$TARGET_ID' no longer exists; backup stays local: $NEW_NAME"
      exit 1
    fi

    RHOST=$(printf '%s' "$CREDS_JSON" | python3 -c "import json,sys; print(json.loads(sys.stdin.read())['host'])")
    RPORT=$(printf '%s' "$CREDS_JSON" | python3 -c "import json,sys; print(json.loads(sys.stdin.read())['port'])")
    RDIR=$(printf '%s' "$CREDS_JSON" | python3 -c "import json,sys; print(json.loads(sys.stdin.read())['remote_dir'])")

    NETRC="/tmp/ops-ftp-$$-scheduled.netrc"
    trap 'dc exec -T backend rm -f "$NETRC" 2>/dev/null || true' EXIT
    printf '%s' "$CREDS_JSON" | python3 -c "
import json, sys
d = json.loads(sys.stdin.read())
print('machine %s' % d['host'])
print('login %s' % d['username'])
print('password %s' % d['password'])
" | dc exec -T backend bash -c 'umask 077; cat > "$1"' _ "$NETRC"
    unset CREDS_JSON

    say "==> Pushing $NEW_NAME to ftp://$RHOST:$RPORT$RDIR/ ..."
    if ! backup_push_files "$NEW_NAME" "$RHOST" "$RPORT" "$RDIR" "$NETRC"; then
      echo "ERROR: push failed. Keeping local copy of $NEW_NAME."
      exit 1
    fi

    say "==> Verifying $NEW_NAME landed remotely..."
    LANDED=$(dc exec -T backend curl -sS -k --ssl --netrc-file "$NETRC" "ftp://$RHOST:$RPORT$RDIR/manifest.json" 2>/dev/null \
      | python3 -c "
import json, sys
try:
    entries = json.load(sys.stdin)
except Exception:
    entries = []
print('1' if any(e.get('name') == '$NEW_NAME' for e in entries) else '')
")
    if [ "$LANDED" != "1" ]; then
      echo "ERROR: push reported success but $NEW_NAME is not in the remote manifest. Keeping local copy."
      exit 1
    fi

    say "==> Confirmed remote, deleting local copy of $NEW_NAME..."
    backup_delete_local "$NEW_NAME"
    echo "Scheduled backup complete: $NEW_NAME pushed off-host, removed locally."
    ;;

  *)
    echo "Environment: $DEPLOY_ENV"
    echo "Usage: ./deploy {init|start|stop|build|fix-assets|setup-prod|setup-dev}"
    echo "       ./deploy ops {up|down|rebuild|logs|status}"
    echo "       ./deploy backup [--no-files] [--keep=N] [--prune-only]"
    echo "       ./deploy restore {--list|<name> [--yes]}"
    echo "       ./deploy backup-remove <name>"
    echo "       ./deploy backup-push <name> <host> <port> <remote-dir> <netrc-file>"
    echo "       ./deploy backup-remote-list <host> <port> <remote-dir> <netrc-file>"
    echo "       ./deploy backup-remote-test <host> <port> <remote-dir> <netrc-file>"
    echo "       ./deploy backup-pull <name> <host> <port> <remote-dir> <netrc-file>"
    echo "       ./deploy backup-scheduled [target-id]  (cron entry point, installed via the ops dashboard)"
    if [ "$DEPLOY_ENV" != "production" ]; then
      echo "       ./deploy {nuke|destroy}  (dev only)"
    fi
    ;;
esac
