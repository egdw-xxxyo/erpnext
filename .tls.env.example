# Copy to .tls.env (gitignored). When TLS_DOMAIN is set, ./deploy starts the
# Traefik sidecar ("tls" compose profile): HTTPS on :443, HTTP :80 -> HTTPS,
# Let's Encrypt cert via Cloudflare DNS-01 (the server does not need to be
# reachable from the internet). Plain http://<ip>:8080 keeps working.
#
# DNS: an A record TLS_DOMAIN -> the server's VPN IP (e.g. 172.16.105.103).
# Token: Cloudflare > My Profile > API Tokens > "Edit zone DNS" template,
# scoped to the zone that holds TLS_DOMAIN.
TLS_DOMAIN=
ACME_EMAIL=
CF_DNS_API_TOKEN=
# Host ports, change only if 80/443 are taken on this host.
TLS_HTTP_PORT=80
TLS_HTTPS_PORT=443
