# syntax=docker/dockerfile:1
ARG ERPNEXT_VERSION=v15.119.0
FROM frappe/erpnext:${ERPNEXT_VERSION}

USER root

# ── System packages ───────────────────────────────────────────────────
# ffmpeg: transcode browser-recorded voice notes (webm/opus) to ogg/opus so
# Meta's WhatsApp Cloud API accepts them (see whatsapp_chat._ensure_whatsapp_audio).
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# ── Replace ERPNext source with ours ──────────────────────────────────
# Only copy the erpnext/ package dir — keep the stock pyproject.toml
# (ours has requires-python>=3.14 which is incompatible with the image's Python 3.11)
COPY --chown=frappe:frappe erpnext/ /home/frappe/frappe-bench/apps/erpnext/erpnext/

# ── Replace Frappe source with our fork ───────────────────────────────
COPY --chown=frappe:frappe frappe/frappe/ /home/frappe/frappe-bench/apps/frappe/frappe/
# Frappe realtime JS lives outside the python package — overlay separately
COPY --chown=frappe:frappe frappe/realtime/ /home/frappe/frappe-bench/apps/frappe/realtime/

# ── Extra pip dependencies (not in pyproject.toml) ────────────────────
RUN /home/frappe/frappe-bench/env/bin/pip install --no-cache-dir qrcode python-barcode Pillow otdrs

# ── Install core apps in editable mode ────────────────────────────────
RUN cd /home/frappe/frappe-bench \
    && ./env/bin/pip install -e apps/frappe \
    && ./env/bin/pip install -e apps/erpnext

# ── Extra apps from apps.json ─────────────────────────────────────────
# All apps are cloned regardless of "enabled" so bench uninstall-app can
# run when an app is disabled (it needs the app code present). The
# "enabled" flag only controls site install/uninstall in ./deploy.
# Cache-bust for the extra-apps clone below: ./deploy sets this to a hash of the
# remote HEADs of every app in apps.json, so a fork push forces a fresh clone
# (Docker otherwise caches this RUN layer forever and never re-pulls fork changes).
ARG APPS_CACHE_BUST=0
COPY apps.json /tmp/apps.json
# --mount=type=secret keeps the PAT out of the image layer entirely (tmpfs,
# only readable during this RUN) — it's for hosts where GitHub 401s on
# anonymous git-upload-pack even for public repos (see deploy's
# GITHUB_TOKEN_FILE). required=false: absent on hosts that don't need it,
# clone falls back to plain anonymous.
RUN --mount=type=secret,id=github_token,required=false \
    echo "apps-cache-bust: $APPS_CACHE_BUST" \
    && python3 -c "import json; [print(a['name'], a['repo'], a['branch']) for a in json.load(open('/tmp/apps.json'))]" > /tmp/extra_apps.txt \
    && sed -i -e '$a\' /home/frappe/frappe-bench/sites/apps.txt \
    && GITHUB_TOKEN="$(cat /run/secrets/github_token 2>/dev/null || true)" \
    && while read name repo branch; do \
         if [ -n "$GITHUB_TOKEN" ]; then \
           git -c "http.extraheader=Authorization: Bearer ${GITHUB_TOKEN}" clone --depth 1 -b "$branch" "$repo" "/home/frappe/frappe-bench/apps/$name"; \
         else \
           git clone --depth 1 -b "$branch" "$repo" "/home/frappe/frappe-bench/apps/$name"; \
         fi \
         && chown -R frappe:frappe "/home/frappe/frappe-bench/apps/$name" \
         && /home/frappe/frappe-bench/env/bin/pip install -e "/home/frappe/frappe-bench/apps/$name" \
         && { [ ! -f "/home/frappe/frappe-bench/apps/$name/package.json" ] || (cd "/home/frappe/frappe-bench/apps/$name" && yarn install); } \
         && echo "$name" >> /home/frappe/frappe-bench/sites/apps.txt \
         || exit 1; \
       done < /tmp/extra_apps.txt

# ── Dummy site config for HRMS frontend build (needs socketio_port) ──
RUN mkdir -p /home/frappe/frappe-bench/sites \
    && echo '{"socketio_port": "9000"}' > /home/frappe/frappe-bench/sites/common_site_config.json

# ── Rebuild JS/CSS assets + compile PO→MO translations ───────────────
# max-old-space-size keeps vite (CRM frontend) under Docker's memory limit —
# without it the build gets OOM-killed (exit 137) at "rendering chunks".
USER frappe
WORKDIR /home/frappe/frappe-bench
ENV NODE_OPTIONS=--max-old-space-size=3072
RUN bench build --force

USER frappe
