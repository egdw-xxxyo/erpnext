ARG ERPNEXT_VERSION=v15.96.1
FROM frappe/erpnext:${ERPNEXT_VERSION}

USER root

# Build tools for translations and extra pip packages
RUN apt-get update && apt-get install -y --no-install-recommends gettext && rm -rf /var/lib/apt/lists/*

# ── Replace ERPNext source with ours ──────────────────────────────────
# Only copy the erpnext/ package dir — keep the stock pyproject.toml
# (ours has requires-python>=3.14 which is incompatible with the image's Python 3.11)
COPY --chown=frappe:frappe erpnext/ /home/frappe/frappe-bench/apps/erpnext/erpnext/

# ── Replace Frappe source with our fork ───────────────────────────────
COPY --chown=frappe:frappe frappe/frappe/ /home/frappe/frappe-bench/apps/frappe/frappe/

# ── Extra pip dependencies (not in pyproject.toml) ────────────────────
RUN /home/frappe/frappe-bench/env/bin/pip install --no-cache-dir qrcode python-barcode Pillow

# ── Re-install apps in editable mode so Python picks up our source ────
RUN cd /home/frappe/frappe-bench \
    && ./env/bin/pip install -e apps/frappe \
    && ./env/bin/pip install -e apps/erpnext

# ── Compile PO → MO translations ─────────────────────────────────────
RUN mkdir -p /home/frappe/frappe-bench/apps/erpnext/erpnext/locale/uk/LC_MESSAGES \
    && msgfmt /home/frappe/frappe-bench/apps/erpnext/erpnext/locale/uk.po \
        -o /home/frappe/frappe-bench/apps/erpnext/erpnext/locale/uk/LC_MESSAGES/erpnext.mo \
    && mkdir -p /home/frappe/frappe-bench/apps/frappe/frappe/locale/uk/LC_MESSAGES \
    && msgfmt /home/frappe/frappe-bench/apps/frappe/frappe/locale/uk.po \
        -o /home/frappe/frappe-bench/apps/frappe/frappe/locale/uk/LC_MESSAGES/frappe.mo

# ── Rebuild JS/CSS assets ─────────────────────────────────────────────
USER frappe
WORKDIR /home/frappe/frappe-bench
RUN bench build

USER frappe
